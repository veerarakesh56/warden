# The cloud runtime's image (G6): the Temporal worker on ECS and the three Lambdas (warden.lambdas) from ONE image,
# built, signed and attested by .github/workflows/runtime.yml and referenced by digest only.
#   ECS:    command ["warden", "worker", "--platform", "aws"]
#   Lambda: entry point ["/opt/warden/bin/python", "-m", "awslambdaric"], command ["warden.lambdas.alarm"] (or
#           .alertmanager, .approval) - AWS's runtime interface client in a non-AWS base image, as AWS documents.
# Base images by digest (audit A-I-24), the same two as ./Dockerfile; Dependabot (docker) proposes new digests.
FROM ghcr.io/astral-sh/uv:0.13.1@sha256:4a1f3666816dafadd20ceb71eac9a7d56d7ef30279f7d64048519ab901ada336 AS uv
FROM ghcr.io/veerarakesh56/warden-mirror/python:3.13-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b AS build

ENV UV_PROJECT_ENVIRONMENT=/opt/warden \
    UV_PYTHON=3.13 \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=1

WORKDIR /app

COPY --from=uv /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock README.md LICENSE NOTICE ./
COPY src ./src

# Only what uv.lock lists, every hash verified (audit A-I-9): the runtime extra (the Lambda runtime interface client,
# AWS, the PostgreSQL audit, passkeys), Kubernetes for the k8s platform, the Anthropic SDK for the llm zone's model
# (the Claude API; Bedrock goes through boto3), Slack, and the injection tripwire (guard: transformers and torch, the
# CPU-only build - pyproject.toml's pytorch-cpu index). Temporal is a core dependency.
RUN uv sync --locked --no-editable --extra runtime --extra k8s --extra anthropic --extra slack --extra guard
# Only the shipped kinds of file (registers R8-O4, R9-O1).
COPY scripts/check_package.py ./
RUN /opt/warden/bin/python check_package.py "$(/opt/warden/bin/python -c 'import os, warden; print(os.path.dirname(warden.__file__))')"
# The tripwire's weights (register R47): Prompt Guard 2 at the pinned revision, fetched with the owner's Hugging Face
# token - a build secret, in no layer - every file checked against the measured copy's hash, then loaded offline and run
# once (an injection must be caught, a plain alert not), or the build fails. The worker never reaches Hugging Face.
# CI builds the image to check what else it carries, with no token: WARDEN_DETECTOR=absent there, and runtime.yml - the
# only build that is deployed - refuses an image without the weights.
COPY scripts/bake_tripwire.py ./
ARG WARDEN_DETECTOR=baked
# Readable by the worker's non-root user, in the same layer (a chmod later would copy the 1.1 GB again): a cache file
# left root-only drew "Permission denied" in the cloud's first load (2026-10-14).
RUN --mount=type=secret,id=hf_token /opt/warden/bin/python bake_tripwire.py /opt/hf "$WARDEN_DETECTOR" && chmod -R a+rX /opt/hf

FROM ghcr.io/veerarakesh56/warden-mirror/python:3.13-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/warden/bin:$PATH
COPY --from=build /opt/warden /opt/warden
COPY --from=build /opt/hf /opt/hf
# The tripwire reads its weights from the image, offline; anything it writes goes to the task's /tmp (a tmpfs - the root
# filesystem is read-only).
ENV HF_HUB_CACHE=/opt/hf \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HOME=/tmp/hf

# Non-root, as ./Dockerfile: an incident-response tool that runs as root is its own incident.
RUN useradd --create-home --uid 10001 warden
# The task's only writable place (its root filesystem is read-only): on Fargate a volume mounted at a path the image
# declares as a VOLUME takes that path's permissions, else it is root's 0755 (AWS's bind-mount guide, read 2026-10-14).
RUN chmod 1777 /tmp
VOLUME ["/tmp"]
USER warden

ENTRYPOINT ["warden"]
CMD ["worker", "--platform", "aws"]
