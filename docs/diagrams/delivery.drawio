        <mxCell id="subtitle" value="Branches main → dev → prod. main runs CI only; each environment deploys only from the branch of its name, through GitHub OIDC (no stored AWS keys)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#52606D;fontSize=13;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
