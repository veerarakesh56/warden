        </mxCell>
        <mxCell id="main" value="&lt;b style='font-size:12px'&gt;main&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;ruleset: no deletion, no force push&lt;br&gt;deploys nothing&lt;br&gt;promoted to dev by fast-forward&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F6FFFB;strokeColor=#12C483;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.5;" vertex="1" parent="1">
