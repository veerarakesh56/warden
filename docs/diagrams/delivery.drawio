        <mxCell id="rt-img" value="&lt;b style='font-size:12px'&gt;runtime.yml · image&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;by hand, from dev only; environment ops&lt;br&gt;(required reviewer)&lt;br&gt;build Dockerfile.runtime with Prompt Guard 2&lt;br&gt;weights · push to ECR by SHA&lt;br&gt;cosign keyless sign + build attestation&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
