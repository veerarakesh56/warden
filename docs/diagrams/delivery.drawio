        <mxCell id="ci-tool" value="&lt;b style='font-size:12px'&gt;CI · tool (ci-tool.yml)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;security: pip-audit · bandit · zizmor&lt;br&gt;check: ruff · publishable scan · pytest ·&lt;br&gt;eval gate · demo verdicts&lt;br&gt;docker · k8s on k3d · db (5 engines) · terraform&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
