        <mxCell id="codeql" value="&lt;b style='font-size:12px'&gt;CodeQL&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;GitHub default setup: Python&lt;br&gt;and the workflows&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
