        <mxCell id="omp" value="&lt;b style='font-size:12px'&gt;on-merge-prod.yml&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;on push to prod:&lt;br&gt;the same jobs, with&lt;br&gt;environment prod&lt;br&gt;and upstream dev&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="800" width="200" height="140" as="geometry" />
