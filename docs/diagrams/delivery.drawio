        <mxCell id="omd" value="&lt;b style='font-size:12px'&gt;on-merge-dev.yml&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;on push to dev:&lt;br&gt;what changed?&lt;br&gt;infra (terraform/fullstack)&lt;br&gt;apps (code, k8s, helm)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="470" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="promo-d" value="&lt;b style='font-size:12px'&gt;Every deploy job first&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;checks the commit was&lt;br&gt;promoted from its upstream&lt;br&gt;branch (main for dev)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F6FFFB;strokeColor=#12C483;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="plan-d" value="&lt;b style='font-size:12px'&gt;infra: plan only&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;_infra-validate → _infra-deploy plan&lt;br&gt;Helios checks the plan (helios_gate.py)&lt;br&gt;the plan and its sha256 are&lt;br&gt;kept for a reviewer&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFF9E8;strokeColor=#E8A33D;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="320" y="440" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="apply-d" value="&lt;b style='font-size:12px'&gt;infra: apply a reviewed plan&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;Deploy · dev (deploy-dev.yml), by hand:&lt;br&gt;apply-plan with the run id + sha256,&lt;br&gt;Helios on it again, apply,&lt;br&gt;Helios on the applied state&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFF9E8;strokeColor=#E8A33D;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="650" y="440" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="apps-d" value="&lt;b style='font-size:12px'&gt;apps: check, then deploy&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;_apps-check → _apps-deploy: Lambdas · ECS · Kubernetes on EKS (with the Datadog agent)&lt;br&gt;only when the infra did not change in the same push - otherwise after its plan is applied&lt;br&gt;Deploy · dev also runs any part by hand: plan · apply · apply-plan · destroy · apps&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="320" y="590" width="630" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ff" value="&lt;b style='font-size:12px'&gt;dev → prod&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;by pull request: dev merged&lt;br&gt;into prod&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F6FFFB;strokeColor=#12C483;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="990" y="636" width="330" height="84" as="geometry" />
