        <mxCell id="plan-p" value="&lt;b style='font-size:12px'&gt;infra: plan, Helios&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;then apply a reviewed plan&lt;br&gt;(Deploy · prod, by hand)&lt;br&gt;apps: check, then deploy&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFF9E8;strokeColor=#E8A33D;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.5;" vertex="1" parent="1">
