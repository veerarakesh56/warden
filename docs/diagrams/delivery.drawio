        <mxCell id="r-dev" value="dev · deploys dev" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#062F45;fontSize=13;startSize=30;fillColor=#3DB9F5;swimlaneFillColor=#FFFFFF;strokeColor=#3DB9F5;fontStyle=1;rounded=1;arcSize=4;collapsible=0;swimlaneLine=0;align=center;spacingLeft=0;horizontal=0;" vertex="1" parent="1">
