        <mxCell id="l-appr" value="&lt;b style='font-size:11px'&gt;Lambda warden-ops-approval&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;/a approve (passkey) · /e enrol · /r records&lt;br&gt;/k reset and /x turn on the kill switch&lt;br&gt;/s Sign in with Slack&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFF9E8;strokeColor=#E8A33D;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
