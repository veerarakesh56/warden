  <diagram name="2 · Identities and surroundings" id="architecture-detailed-2">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="logo" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;aspect=fixed;verticalLabelPosition=bottom;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="22" width="54" height="54" as="geometry" />
        </mxCell>
        <mxCell id="title" value="&lt;b&gt;WARDEN · detailed architecture (2 of 2): identities, environments and outside services&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#0B2530;fontSize=24;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="98" y="24" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Who may do what, per environment (iam/&amp;lt;env&amp;gt;/*.json, rendered by scripts/render_env_iam.py), and every outside service WARDEN talks to." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#52606D;fontSize=13;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="98" y="56" width="1300" height="22" as="geometry" />
        </mxCell>
        <mxCell id="aws" value="AWS account · ap-south-2 · one account, environments separated by name, tags, boundary and SSM path" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#33424F;fontSize=13;rounded=1;arcSize=2;fillColor=none;strokeColor=#7B8794;dashed=1;dashPattern=8 5;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="1240" height="900" as="geometry" />
        </mxCell>
        <mxCell id="dev" value="Environment dev (tier nonprod, run as production)" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;startSize=26;fillColor=#E4E9EE;swimlaneFillColor=#FFFFFF;strokeColor=#E4E9EE;fontStyle=1;rounded=1;arcSize=4;collapsible=0;swimlaneLine=0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="396" height="640" as="geometry" />
        </mxCell>
        <mxCell id="dev-t" value="&lt;span style='font-size:11px;color:#52606D'&gt;Faults are injected only here (environments.yaml fault_environments). Fixes need a signed approval; the labelled bench approver may approve T1/T2.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="52" y="172" width="372" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dev-res" value="&lt;b style='font-size:12px'&gt;Resources warden-dev-*&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;EKS · ECS · Lambda · RDS / Aurora · DynamoDB · SQS · SNS&lt;br&gt;ElastiCache · API Gateway · ALB · CloudWatch alarms&lt;br&gt;(terraform/fullstack, deployed from the branch of the same name)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="52" y="212" width="372" height="96" as="geometry" />
        </mxCell>
        <mxCell id="dev-reader" value="&lt;b style='font-size:12px'&gt;warden-dev-platform-reader&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;read-only; trusts warden-ops-read and -notify (and -act, which re-reads)&lt;br&gt;SourceIdentity inc-&amp;lt;id&amp;gt; or warden-worker&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#EAF7FE;strokeColor=#3DB9F5;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="52" y="322" width="372" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dev-actor" value="&lt;b style='font-size:12px'&gt;warden-dev-actor&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;writes; trusts only warden-ops-act, SourceIdentity inc-*&lt;br&gt;session tags approver, incident, plan required&lt;br&gt;≤ 900 s, session policy = the plan's exact ARNs&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFF0ED;strokeColor=#FF7E6B;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="52" y="404" width="372" height="84" as="geometry" />
        </mxCell>
        <mxCell id="dev-deploy" value="&lt;b style='font-size:12px'&gt;warden-dev-deploy&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;GitHub OIDC only: environment dev, branch dev,&lt;br&gt;_infra-deploy.yml / _apps-deploy.yml at that branch&lt;br&gt;policies deploy + deploy-ec2 + deploy-guard&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="52" y="500" width="372" height="84" as="geometry" />
        </mxCell>
        <mxCell id="dev-bound" value="&lt;b style='font-size:12px'&gt;Boundary WardenEnvBoundary-dev&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;the ceiling on every role in it: this Region, own names&lt;br&gt;deploy-guard: no policy on an unbounded role;&lt;br&gt;the owner's Datadog key: read only&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="52" y="596" width="372" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dev-extra" value="&lt;b style='font-size:12px'&gt;Fault injection, dev only&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;warden-dev-harness: the benchmark harness and&lt;br&gt;the undo lab, run by the operator&lt;br&gt;Datadog agent on EKS (own key warden-dev-datadog-api-key)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="52" y="678" width="372" height="90" as="geometry" />
        </mxCell>
        <mxCell id="prod" value="Environment prod (tier prod)" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;startSize=26;fillColor=#E4E9EE;swimlaneFillColor=#FFFFFF;strokeColor=#E4E9EE;fontStyle=1;rounded=1;arcSize=4;collapsible=0;swimlaneLine=0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="452" y="140" width="396" height="640" as="geometry" />
        </mxCell>
        <mxCell id="prod-t" value="&lt;span style='font-size:11px;color:#52606D'&gt;Never auto. Each fix: a signed approval of its exact plan; scale_down is denied. Deploys wait for the owner as required reviewer.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="464" y="172" width="372" height="40" as="geometry" />
        </mxCell>
        <mxCell id="prod-res" value="&lt;b style='font-size:12px'&gt;Resources warden-prod-*&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;EKS · ECS · Lambda · RDS / Aurora · DynamoDB · SQS · SNS&lt;br&gt;ElastiCache · API Gateway · ALB · CloudWatch alarms&lt;br&gt;(terraform/fullstack, deployed from the branch of the same name)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="464" y="212" width="372" height="96" as="geometry" />
        </mxCell>
        <mxCell id="prod-reader" value="&lt;b style='font-size:12px'&gt;warden-prod-platform-reader&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;read-only; trusts warden-ops-read and -notify (and -act, which re-reads)&lt;br&gt;SourceIdentity inc-&amp;lt;id&amp;gt; or warden-worker&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#EAF7FE;strokeColor=#3DB9F5;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="464" y="322" width="372" height="70" as="geometry" />
        </mxCell>
        <mxCell id="prod-actor" value="&lt;b style='font-size:12px'&gt;warden-prod-actor&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;writes; trusts only warden-ops-act, SourceIdentity inc-*&lt;br&gt;session tags approver, incident, plan required&lt;br&gt;≤ 900 s, session policy = the plan's exact ARNs&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFF0ED;strokeColor=#FF7E6B;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="464" y="404" width="372" height="84" as="geometry" />
        </mxCell>
        <mxCell id="prod-deploy" value="&lt;b style='font-size:12px'&gt;warden-prod-deploy&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;GitHub OIDC only: environment prod, branch prod,&lt;br&gt;_infra-deploy.yml / _apps-deploy.yml at that branch&lt;br&gt;policies deploy + deploy-ec2 + deploy-guard&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="464" y="500" width="372" height="84" as="geometry" />
        </mxCell>
        <mxCell id="prod-bound" value="&lt;b style='font-size:12px'&gt;Boundary WardenEnvBoundary-prod&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;the ceiling on every role in it: this Region, own names&lt;br&gt;deploy-guard: no policy on an unbounded role;&lt;br&gt;the owner's Datadog key: read only&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="464" y="596" width="372" height="70" as="geometry" />
        </mxCell>
        <mxCell id="prod-extra" value="&lt;b style='font-size:12px'&gt;No fault-injection role&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;fault_environments refuses the prod tier&lt;br&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="464" y="678" width="372" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ops" value="Environment ops (WARDEN itself)" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fontSize=12;startSize=26;fillColor=#0B2530;swimlaneFillColor=#FFFFFF;strokeColor=#0B2530;fontStyle=1;rounded=1;arcSize=4;collapsible=0;swimlaneLine=0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="864" y="140" width="376" height="640" as="geometry" />
        </mxCell>
        <mxCell id="ops-t" value="&lt;span style='font-size:11px;color:#52606D'&gt;Not an application environment: WARDEN never remediates it; an alarm about WARDEN only escalates to a person.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="876" y="172" width="352" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ops-zones" value="&lt;b style='font-size:12px'&gt;Zone task roles warden-ops-&amp;lt;zone&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;core · llm: assume nothing; each reads only its own secrets&lt;br&gt;read · notify: may assume warden-&amp;lt;env&amp;gt;-platform-reader&lt;br&gt;act: platform-reader and warden-&amp;lt;env&amp;gt;-actor, per incident&lt;br&gt;&lt;b&gt;Every zone writes&lt;/b&gt; only WARDEN's own record: the audit&lt;br&gt;as warden_audit_writer (SELECT + INSERT), kms:Sign, S3 anchors&lt;br&gt;&lt;b&gt;Only act writes watched resources&lt;/b&gt;, through the per-plan&lt;br&gt;actor session (≤ 900 s, exact ARNs). No zone holds a&lt;br&gt;standing write to a watched resource.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B8C4CE;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="876" y="212" width="352" height="182" as="geometry" />
        </mxCell>
        <mxCell id="ops-fd" value="&lt;b style='font-size:12px'&gt;A role per Lambda: warden-ops-&amp;lt;name&amp;gt;-lambda&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;no role to assume, no model, its own secrets only&lt;br&gt;warden-ops-ack: no policy at all&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B8C4CE;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="876" y="402" width="352" height="62" as="geometry" />
        </mxCell>
        <mxCell id="ops-deploy" value="&lt;b style='font-size:12px'&gt;warden-ops-deploy&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;GitHub OIDC only: environment ops, branch dev,&lt;br&gt;runtime.yml at refs/heads/dev&lt;br&gt;runtime-* templates · WardenEnvBoundary-ops&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="876" y="472" width="352" height="74" as="geometry" />
        </mxCell>
        <mxCell id="ops-misc" value="&lt;b style='font-size:12px'&gt;Also&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;warden-ops-migrate (audit schema)&lt;br&gt;warden-ops-forward-alarms (us-east-1 rule)&lt;br&gt;operator (laptop): sees secret names, never values;&lt;br&gt;assumes warden-ops-sweep for a read-only sweep&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="876" y="552" width="352" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ops-ks" value="&lt;b style='font-size:12px'&gt;Kill switch&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;on: an apply or rollback that failed, or /x&lt;br&gt;checked at the gate and again right before apply&lt;br&gt;off: only an approver, /k (signed link)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFF0ED;strokeColor=#FF7E6B;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="876" y="674" width="352" height="94" as="geometry" />
        </mxCell>
        <mxCell id="same" value="&lt;span style='font-size:11px;color:#52606D'&gt;Every name is derived from the environment name (environments.names()): prefix warden-&amp;lt;env&amp;gt;-, tag Environment=&amp;lt;env&amp;gt;, SSM /warden/&amp;lt;env&amp;gt;/, boundary WardenEnvBoundary-&amp;lt;env&amp;gt;. An unknown environment gets the most restrictive default.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="watch" value="&lt;b style='font-size:12px'&gt;Watching WARDEN itself&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;Heartbeat: each worker beats only after a full round trip through Temporal; silence pages (warden-ops-heartbeat-missing).&lt;br&gt;Synthetic: once a day a recorded incident runs through the model and the gate in shadow; 25 hours without a pass pages.&lt;br&gt;actor-use: every AssumeRole of an actor role is checked against the audit; an unapproved one pages. A change to the approver list pages too.&lt;br&gt;All pages are published to SNS warden-ops-page; its e-mail subscriber is pending confirmation (2026-10-16).&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F6FFFB;strokeColor=#12C483;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="846" width="1200" height="134" as="geometry" />
        </mxCell>
        <mxCell id="outside" value="Outside services" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fontSize=12;startSize=26;fillColor=#4B5563;swimlaneFillColor=#FAFBFC;strokeColor=#4B5563;fontStyle=1;rounded=1;arcSize=4;collapsible=0;swimlaneLine=0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1290" y="100" width="580" height="900" as="geometry" />
        </mxCell>
        <mxCell id="o0" value="&lt;b style='font-size:12px'&gt;Temporal Cloud&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;namespace in aws-ap-south-2 · API key per zone, one for the Lambdas · payloads encrypted&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=left;spacing=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1304" y="136" width="552" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="&lt;b style='font-size:12px'&gt;Anthropic Claude API&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;Claude Sonnet 5.5 (providers.yaml, qualified on 30 recorded incidents) · llm zone only&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=left;spacing=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1304" y="206" width="552" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="&lt;b style='font-size:12px'&gt;Slack&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;dev-alerts/discuss, prod-alerts/discuss (WARDEN_SLACK_CHANNELS, WARDEN_DISCUSS_CHANNELS) · Socket Mode · Sign in with Slack&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=left;spacing=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1304" y="276" width="552" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="&lt;b style='font-size:12px'&gt;Datadog&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;runtime: read keys (read zone), webhook token (front door) · dev agent: its own key&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=left;spacing=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1304" y="346" width="552" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="&lt;b style='font-size:12px'&gt;AWS Knowledge MCP&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;knowledge-mcp.global.api.aws · error codes only, answers are reference, never evidence&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=left;spacing=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1304" y="416" width="552" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="&lt;b style='font-size:12px'&gt;Hugging Face&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;Prompt Guard 2 weights, pinned and checked when the runtime image is built (HF_TOKEN in ops)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=left;spacing=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1304" y="486" width="552" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o6" value="&lt;b style='font-size:12px'&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;CI, CodeQL, SonarCloud, CodeRabbit; OIDC deploys; an issue per applied change (github-token)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=left;spacing=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1304" y="556" width="552" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o7" value="&lt;b style='font-size:12px'&gt;PagerDuty · Teams · webhooks&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;supported by the code (settings.py) for adopters; no secret slot in this runtime&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=left;spacing=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1304" y="626" width="552" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o-mcp" value="&lt;b style='font-size:12px'&gt;WARDEN's MCP server (warden-mcp, offered)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;stdio, run by an agent's own host - not part of the cloud runtime:&lt;br&gt;start_incident_diagnosis · request_remediation · workflow_status · verify_remediation&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#12C483;verticalAlign=middle;align=left;spacing=6;dashed=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1304" y="700" width="552" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o-dep" value="&lt;b style='font-size:12px'&gt;Dependency review watch (in review, not merged)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;branch dependency-watch: every 3 days WARDEN reviews each open Dependabot PR&lt;br&gt;and security alert: GitHub read (read zone, read-only token), effects (llm), risk&lt;br&gt;and plan from rules (core), digest in the discussion channel (notify)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#5C4A00;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFBEA;strokeColor=#C9A227;verticalAlign=middle;align=left;spacing=6;dashed=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1304" y="782" width="552" height="84" as="geometry" />
        </mxCell>
        <mxCell id="o-helios" value="&lt;b style='font-size:12px'&gt;Helios (the owner's Terraform plan checker, Rust + Z3)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;in _infra-deploy.yml: built from a pinned commit before the job holds credentials;&lt;br&gt;checks the plan, the reviewed plan again before apply, and the applied state&lt;br&gt;(scripts/helios_gate.py)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=left;spacing=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1304" y="878" width="552" height="100" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="&lt;span style='font-size:11px;color:#52606D'&gt;Drawn from origin/main de1cbcd (2026-10-16). Dashed yellow: open pull request or unmerged branch. Delivery pipelines in detail: delivery.drawio. Incident lifecycle: incident-flow.drawio.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="1020" width="1840" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
