        <mxCell id="apigw" value="&lt;b style='font-size:11px'&gt;API Gateway HTTP API warden-ops-front&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;custom domain = the approval domain&lt;br&gt;TLS 1.2 · every route throttled&lt;br&gt;JSON access logs&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B8C4CE;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
