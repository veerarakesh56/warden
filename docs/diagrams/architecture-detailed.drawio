        <mxCell id="logo" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;aspect=fixed;verticalLabelPosition=bottom;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="22" width="54" height="54" as="geometry" />
        </mxCell>
        <mxCell id="title" value="&lt;b&gt;WARDEN · detailed architecture (1 of 2): the runtime&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#0B2530;fontSize=24;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="98" y="24" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Every box is a resource in terraform/modules/warden-runtime or a module in src/warden, by its real name (environment ops shown; &amp;lt;env&amp;gt; = dev or prod). Root: terraform/runtime." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#52606D;fontSize=13;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="98" y="56" width="1300" height="22" as="geometry" />
        </mxCell>
        <mxCell id="temporal" value="Temporal Cloud · namespace in aws-ap-south-2 (outside the AWS account)" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fontSize=12;startSize=26;fillColor=#4B5563;swimlaneFillColor=#F4F6F8;strokeColor=#4B5563;fontStyle=1;rounded=1;arcSize=4;collapsible=0;swimlaneLine=0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="840" height="112" as="geometry" />
        </mxCell>
        <mxCell id="temporal-b" value="&lt;span style='font-size:11px;color:#52606D'&gt;&lt;b style='color:#1F2933'&gt;Workflows&lt;/b&gt; (workflows.py): IncidentWorkflow &lt;i&gt;inc-&amp;lt;id&amp;gt;&lt;/i&gt; · RemediationWorkflow, one per target · DiscussWorkflow · ClockWorkflow&lt;br&gt;&lt;b style='color:#1F2933'&gt;Task queues&lt;/b&gt;: warden (core) · warden-read · warden-llm · warden-notify · warden-act&lt;br&gt;&lt;b style='color:#1F2933'&gt;Keys&lt;/b&gt;: one API key per zone (temporal-api-key-&amp;lt;zone&amp;gt;) and one for the Lambdas · every payload AES-256-GCM encrypted by WARDEN (codec.py, temporal-key)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="654" y="132" width="820" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aws" value="AWS account · ap-south-2 · runtime (ops)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#33424F;fontSize=13;rounded=1;arcSize=2;fillColor=none;strokeColor=#7B8794;dashed=1;dashPattern=8 5;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="236" width="1480" height="1170" as="geometry" />
        </mxCell>
        <mxCell id="src-events" value="&lt;b style='font-size:12px'&gt;Watched environments' events&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;CloudWatch alarm state changes&lt;br&gt;of alarms named warden-&amp;lt;env&amp;gt;-*&lt;br&gt;ECS service WARN / ERROR&lt;br&gt;RDS failure, failover, low storage&lt;br&gt;AWS Health: open account issues&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="250" height="132" as="geometry" />
        </mxCell>
        <mxCell id="src-global" value="&lt;b style='font-size:12px'&gt;us-east-1 · global-service alarms&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;CloudFront, Route 53 health checks&lt;br&gt;rule warden-ops-global-alarm-changes&lt;br&gt;→ this Region's default bus&lt;br&gt;(scripts/forward_global_alarms.py)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="448" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="src-trail" value="&lt;b style='font-size:12px'&gt;CloudTrail trail warden-ops-witness&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;AWS's own record, written to S3&lt;br&gt;warden-ops-witness-* (Object Lock,&lt;br&gt;log file validation): every&lt;br&gt;AssumeRole and kms:Sign&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="574" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="watched" value="&lt;b style='font-size:12px'&gt;Watched environments · dev, prod&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;warden-&amp;lt;env&amp;gt;-* resources:&lt;br&gt;EKS · ECS · Lambda · RDS / Aurora&lt;br&gt;DynamoDB · SQS · SNS · ElastiCache&lt;br&gt;API Gateway · ALB&lt;br&gt;&lt;br&gt;&lt;b&gt;warden-&amp;lt;env&amp;gt;-platform-reader&lt;/b&gt;&lt;br&gt;read-only · SourceIdentity inc-&amp;lt;id&amp;gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;warden-&amp;lt;env&amp;gt;-actor&lt;/b&gt;&lt;br&gt;writes · ≤ 900 s · session policy&lt;br&gt;naming the plan's exact ARNs&lt;br&gt;&lt;br&gt;(roles and boundaries: page 2)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="250" height="280" as="geometry" />
        </mxCell>
        <mxCell id="intake" value="Event intake" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fontSize=12;startSize=26;fillColor=#0B2530;swimlaneFillColor=#FFFFFF;strokeColor=#0B2530;fontStyle=1;rounded=1;arcSize=4;collapsible=0;swimlaneLine=0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="290" width="312" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eb-alarms" value="&lt;b style='font-size:12px'&gt;EventBridge rules&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;warden-ops-alarm-changes&lt;br&gt;warden-ops-ecs-events · -rds-events · -health-events&lt;br&gt;8 retries within 1 h, then the dead-letter queue&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B8C4CE;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="324" y="326" width="284" height="92" as="geometry" />
        </mxCell>
        <mxCell id="l-alarm" value="&lt;b style='font-size:12px'&gt;Lambda warden-ops-alarm&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;intake: dedupe by fingerprint, storms join,&lt;br&gt;flapping escalates, open-incident caps&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFF9E8;strokeColor=#E8A33D;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="324" y="432" width="284" height="74" as="geometry" />
        </mxCell>
        <mxCell id="dlq" value="&lt;b style='font-size:12px'&gt;SQS warden-ops-alarm-dlq&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;undelivered events, 14 days; any message pages&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B8C4CE;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="324" y="518" width="284" height="50" as="geometry" />
        </mxCell>
        <mxCell id="eb-actor" value="&lt;b style='font-size:11px'&gt;EventBridge&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;warden-ops-actor-use&lt;br&gt;warden-ops-&lt;br&gt;approvers-changed&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B8C4CE;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="324" y="582" width="136" height="114" as="geometry" />
        </mxCell>
        <mxCell id="l-actor" value="&lt;b style='font-size:11px'&gt;Lambda warden-ops-actor-use&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;an actor session the audit&lt;br&gt;does not show approved&lt;br&gt;pages a person&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFF9E8;strokeColor=#E8A33D;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="470" y="582" width="138" height="114" as="geometry" />
        </mxCell>
        <mxCell id="cluster" value="ECS cluster warden-ops-runtime · Fargate · one service and task role per zone" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;startSize=26;fillColor=#DDE3E9;swimlaneFillColor=#FFFFFF;strokeColor=#DDE3E9;fontStyle=1;rounded=1;arcSize=4;collapsible=0;swimlaneLine=0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="290" width="540" height="790" as="geometry" />
        </mxCell>
        <mxCell id="every" value="&lt;span style='font-size:11px;color:#52606D'&gt;Each task: its own micro-VM, read-only root filesystem, non-root user, no instance metadata. Every zone also reads temporal-key and temporal-api-key-&amp;lt;zone&amp;gt;, its settings and the approver list; may kms:Sign, write the audit as warden_audit_writer and put anchors.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="652" y="320" width="520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="z-core" value="core · warden-ops-core · queue warden" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fontSize=12;startSize=24;fillColor=#12C483;swimlaneFillColor=#E6F9F1;strokeColor=#12C483;fontStyle=1;rounded=1;arcSize=4;collapsible=0;swimlaneLine=0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="654" y="372" width="512" height="160" as="geometry" />
        </mxCell>
        <mxCell id="z-core-r" value="&lt;span style='font-size:11px;color:#1F2933'&gt;&lt;b style='color:#1F2933'&gt;Runs&lt;/b&gt;&lt;br&gt;the workflows themselves&lt;br&gt;verify: the policies (verifier.py), grounding&lt;br&gt;second_opinion: two diagnoses must agree&lt;br&gt;gate: bounds, cool-down, &lt;b&gt;kill switch&lt;/b&gt;, freezes&lt;br&gt;check_passkey · check_approval&lt;br&gt;record_result, side_effects&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="664" y="402" width="262" height="126" as="geometry" />
        </mxCell>
        <mxCell id="z-core-s" value="&lt;span style='font-size:11px;color:#1F2933'&gt;&lt;b style='color:#1F2933'&gt;Secrets&lt;/b&gt;&lt;br&gt;(the common ones only)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="934" y="402" width="146" height="126" as="geometry" />
