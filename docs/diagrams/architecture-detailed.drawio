        <mxCell id="z-llm-r" value="&lt;span style='font-size:11px;color:#1F2933'&gt;&lt;b style='color:#1F2933'&gt;Runs&lt;/b&gt;&lt;br&gt;diagnose: up to 6 calls, US$0.25&lt;br&gt;per incident · discuss_answer&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
