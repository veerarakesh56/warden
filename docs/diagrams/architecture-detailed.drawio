        <mxCell id="http" value="HTTP front door" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fontSize=12;startSize=26;fillColor=#0B2530;swimlaneFillColor=#FFFFFF;strokeColor=#0B2530;fontStyle=1;rounded=1;arcSize=4;collapsible=0;swimlaneLine=0;align=left;spacingLeft=10;" vertex="1" parent="1">
