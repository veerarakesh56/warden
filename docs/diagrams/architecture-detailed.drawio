<mxfile host="drawio" agent="WARDEN docs/diagrams generator" version="31.5.2">
  <diagram name="1 · Runtime" id="architecture-detailed-1">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
