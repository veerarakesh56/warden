        <mxCell id="l-ack" value="&lt;b style='font-size:11px'&gt;Lambda warden-ops-ack&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;POST /s/interact: answers Slack in 3 s,&lt;br&gt;no permission, reads nothing&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFF9E8;strokeColor=#E8A33D;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
