        <mxCell id="z-notify-r" value="&lt;span style='font-size:11px;color:#1F2933'&gt;&lt;b style='color:#1F2933'&gt;Runs&lt;/b&gt;&lt;br&gt;notify through the outbound gate (gate.py),&lt;br&gt;to the incident environment's channel&lt;br&gt;announce · finish · no_plan · summary_owed&lt;br&gt;discuss_thread / discuss_reply&lt;br&gt;Slack Socket Mode listener (discuss.py)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="664" y="686" width="262" height="96" as="geometry" />
