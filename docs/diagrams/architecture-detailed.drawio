        <mxCell id="z-notify" value="notify · warden-ops-notify · queue warden-notify" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#06392A;fontSize=12;startSize=24;fillColor=#7DF2C4;swimlaneFillColor=#EFFDF7;strokeColor=#7DF2C4;fontStyle=1;rounded=1;arcSize=4;collapsible=0;swimlaneLine=0;align=left;spacingLeft=10;" vertex="1" parent="1">
