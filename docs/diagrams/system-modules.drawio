        </mxCell>
        <mxCell id="in-alarm" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;an alarm or a service&#x27;s own event&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#52606D&#x27;&gt;CloudWatch alarm change, ECS / RDS / AWS Health&lt;br&gt;event: EventBridge → the alarm Lambda&lt;br&gt;&lt;i&gt;lambdas.py&lt;/i&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;verticalAlign=middle;spacing=6;fillColor=#F4F6F8;strokeColor=#B8C4CE;align=left;spacingLeft=10;" vertex="1" parent="1">
