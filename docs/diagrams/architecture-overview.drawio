        <mxCell id="temporal" value="&lt;b style='font-size:12px'&gt;Temporal Cloud · namespace in aws-ap-south-2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;durable workflows: incident · fix plan · discussion&lt;br&gt;payloads encrypted by WARDEN before they leave&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#7B8794;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
