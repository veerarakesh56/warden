        </mxCell>
        <mxCell id="subtitle" value="An AI on-call engineer for AWS: it reads an incident, explains it, and changes nothing without a person's passkey." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#52606D;fontSize=13;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
