        <mxCell id="watched" value="Watched environments · dev, prod" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=13;startSize=26;fillColor=#E4E9EE;swimlaneFillColor=#FAFBFC;strokeColor=#E4E9EE;fontStyle=1;rounded=1;arcSize=4;collapsible=0;swimlaneLine=0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="56" y="262" width="280" height="584" as="geometry" />
        </mxCell>
        <mxCell id="watched-body" value="&lt;span style='font-size:12px'&gt;Each named &lt;b&gt;warden-&amp;lt;env&amp;gt;-*&lt;/b&gt;:&lt;br&gt;&lt;br&gt;EKS · ECS · Lambda&lt;br&gt;RDS / Aurora · DynamoDB&lt;br&gt;SQS · SNS · ElastiCache&lt;br&gt;API Gateway · ALB&lt;br&gt;&lt;br&gt;&lt;b&gt;CloudWatch alarms&lt;/b&gt; and the services' own&lt;br&gt;ECS, RDS and AWS Health events&lt;br&gt;&lt;br&gt;dev's EKS cluster runs the&lt;br&gt;Datadog agent&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="72" y="300" width="252" height="360" as="geometry" />
        </mxCell>
        <mxCell id="reader" value="&lt;b style='font-size:12px'&gt;platform-reader role&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;read-only, one session per incident&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#EAF7FE;strokeColor=#3DB9F5;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
