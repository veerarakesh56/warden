<mxfile host="drawio" agent="WARDEN docs/diagrams generator" version="31.5.2">
  <diagram name="AWS architecture" id="aws-architecture">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2840" pageHeight="2080" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="logo" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;aspect=fixed;verticalLabelPosition=bottom;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="22" width="54" height="54" as="geometry" />
        </mxCell>
        <mxCell id="title" value="&lt;b&gt;WARDEN · AWS architecture: what runs where&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#0B2530;fontSize=24;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="98" y="24" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="WARDEN&#x27;s own runtime (ops), the full stack it watches (dev), the account-wide pieces and the outside services at the edge - each by the name the code gives it (terraform/, iam/, k8s/, manifests/, scripts/, src/warden/). One AWS account; environments are separated by name (warden-&amp;lt;env&amp;gt;-*), the Environment tag, a permissions boundary WardenEnvBoundary-&amp;lt;env&amp;gt; and the SSM path /warden/&amp;lt;env&amp;gt;/." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#52606D;fontSize=13;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="98" y="56" width="2700" height="36" as="geometry" />
        </mxCell>
        <mxCell id="op-laptop" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Operator&#x27;s laptop&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#52606D&#x27;&gt;IAM Roles Anywhere certificate, key in the TPM&lt;br&gt;harness, sweeps, one-time setup&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;verticalAlign=middle;spacing=6;fillColor=#F4F6F8;strokeColor=#7B8794;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="96" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="github" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#52606D&#x27;&gt;repository · Actions with OIDC, no AWS keys: CI on main,&lt;br&gt;deploys from dev (prod: planned) · an issue per applied change&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;verticalAlign=middle;spacing=6;fillColor=#F4F6F8;strokeColor=#7B8794;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="96" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hf" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Hugging Face&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#52606D&#x27;&gt;Prompt Guard 2 weights, read only&lt;br&gt;when the runtime image is built&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;verticalAlign=middle;spacing=6;fillColor=#F4F6F8;strokeColor=#7B8794;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="96" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="datadog" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Datadog&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#52606D&#x27;&gt;the dev cluster&#x27;s agent sends logs, metrics, APM&lt;br&gt;WARDEN reads with a scoped key · monitors post to WARDEN&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;verticalAlign=middle;spacing=6;fillColor=#F4F6F8;strokeColor=#7B8794;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="96" width="430" height="80" as="geometry" />
