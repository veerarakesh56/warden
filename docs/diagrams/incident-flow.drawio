        </mxCell>
        <mxCell id="lane-act" value="act zone" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3D0E06;fontSize=13;startSize=30;fillColor=#FF7E6B;swimlaneFillColor=#FFF0ED;strokeColor=#FF7E6B;fontStyle=1;rounded=1;arcSize=2;collapsible=0;swimlaneLine=0;align=center;spacingLeft=0;" vertex="1" parent="1">
