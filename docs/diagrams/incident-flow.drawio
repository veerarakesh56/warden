        </mxCell>
        <mxCell id="legend" value="Safety checks" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fontSize=13;startSize=30;fillColor=#0A9A6A;swimlaneFillColor=#F6FFFB;strokeColor=#0A9A6A;fontStyle=1;rounded=1;arcSize=4;collapsible=0;swimlaneLine=0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="100" width="370" height="1060" as="geometry" />
        </mxCell>
        <mxCell id="lg-S1" value="&lt;b&gt;S1&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="142" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S1-t" value="&lt;span style='font-size:11px'&gt;Intake joins repeats and storms to one incident; flapping alarms only escalate; open incidents are capped.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="142" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg-S2" value="&lt;b&gt;S2&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="214" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S2-t" value="&lt;span style='font-size:11px'&gt;Reads use a read-only role for this incident only; CloudTrail stamps every call with inc-&amp;lt;id&amp;gt;.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="214" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg-S3" value="&lt;b&gt;S3&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="286" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S3-t" value="&lt;span style='font-size:11px'&gt;Redaction is proved, not assumed; the placeholder map never leaves the read zone.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="286" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg-S4" value="&lt;b&gt;S4&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="358" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S4-t" value="&lt;span style='font-size:11px'&gt;Untrusted text never reaches the model as text: only typed facts. Prompt Guard 2 is a tripwire, not a gate.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="358" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg-S5" value="&lt;b&gt;S5&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="430" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S5-t" value="&lt;span style='font-size:11px'&gt;The model's budget is enforced in the call path. No model, or over budget: a rules-only report to a person.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="430" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg-S6" value="&lt;b&gt;S6&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="502" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S6-t" value="&lt;span style='font-size:11px'&gt;Plain code decides: every claim must cite evidence; a second diagnosis must agree, or it goes to a person.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="502" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg-S7" value="&lt;b&gt;S7&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="574" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S7-t" value="&lt;span style='font-size:11px'&gt;A plan is made from live state and hashed; only the alarm's own resources can be a target.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="574" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg-S8" value="&lt;b&gt;S8&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="646" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S8-t" value="&lt;span style='font-size:11px'&gt;Kill switch, bounds, cool-down, change freezes and the approval-fatigue cap, checked before anyone is asked.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="646" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg-S9" value="&lt;b&gt;S9&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="718" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S9-t" value="&lt;span style='font-size:11px'&gt;Everything said leaves through the outbound gate (no links, images or secrets), and only to the incident environment's own channels: a dev incident never reaches a prod channel.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="718" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg-S10" value="&lt;b&gt;S10&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="790" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S10-t" value="&lt;span style='font-size:11px'&gt;A person signs the exact plan hash: a passkey on the approval page after typing the target (or the break-glass CLI key).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="790" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg-S11" value="&lt;b&gt;S11&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="862" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S11-t" value="&lt;span style='font-size:11px'&gt;If the target changed after approval, nothing is applied unseen: a new plan is asked for.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="862" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg-S12" value="&lt;b&gt;S12&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="934" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S12-t" value="&lt;span style='font-size:11px'&gt;Applied at most once; credentials last ≤ 15 min, name the approvers, and reach only the plan's resources.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="934" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg-S13" value="&lt;b&gt;S13&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="1006" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S13-t" value="&lt;span style='font-size:11px'&gt;AWS's own record is checked against WARDEN's: an actor session without a signed approval pages a person.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="1006" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg-S14" value="&lt;b&gt;S14&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1454" y="1078" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-S14-t" value="&lt;span style='font-size:11px'&gt;The record is tamper-evident: hash chain, KMS signature nobody can export, Object Lock anchors.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1502" y="1078" width="294" height="70" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="&lt;span style='font-size:10px;color:#52606D'&gt;Drawn from origin/main de1cbcd (2026-10-16): workflows.py (IncidentWorkflow, RemediationWorkflow), activities.py, lambdas.py, identity.py, bounds.py, verifier.py. Solid: the path taken; dashed: a loop or the other branch.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="1770" width="1780" height="24" as="geometry" />
        </mxCell>
      </root>
