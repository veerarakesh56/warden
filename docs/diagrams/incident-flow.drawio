        </mxCell>
        <mxCell id="a1" value="&lt;b style='font-size:12px'&gt;Alarm → intake&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;EventBridge → Lambda&lt;br&gt;warden-ops-alarm:&lt;br&gt;dedupe by fingerprint,&lt;br&gt;flapping and storms only&lt;br&gt;escalate, open-incident cap&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="239" y="150" width="176" height="112" as="geometry" />
        </mxCell>
        <mxCell id="a1-s" value="&lt;b&gt;S1&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="381" y="141" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b style='font-size:12px'&gt;IncidentWorkflow&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;id inc-&amp;lt;id&amp;gt; in Temporal&lt;br&gt;(same alarm twice = one&lt;br&gt;incident); waits for the&lt;br&gt;logs to arrive&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="839" y="150" width="176" height="112" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b style='font-size:12px'&gt;prepare: gather&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;assumes warden-&amp;lt;env&amp;gt;-&lt;br&gt;platform-reader, 15 min,&lt;br&gt;SourceIdentity inc-&amp;lt;id&amp;gt;&lt;br&gt;logs, metrics, deploys, changes&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="439" y="290" width="176" height="96" as="geometry" />
        </mxCell>
        <mxCell id="a3-s" value="&lt;b&gt;S2&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="581" y="281" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b style='font-size:12px'&gt;redact&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;mask identifiers and secrets,&lt;br&gt;then prove none survived;&lt;br&gt;the map never leaves&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="439" y="404" width="176" height="86" as="geometry" />
        </mxCell>
        <mxCell id="a4-s" value="&lt;b&gt;S3&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="581" y="395" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b style='font-size:12px'&gt;tripwire · quarantine&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;Prompt Guard 2 scans every&lt;br&gt;untrusted line; the text&lt;br&gt;becomes typed facts&lt;br&gt;with evidence ids&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="439" y="508" width="176" height="96" as="geometry" />
        </mxCell>
        <mxCell id="a5-s" value="&lt;b&gt;S4&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="581" y="499" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="&lt;b style='font-size:12px'&gt;diagnose (the model)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;Claude Sonnet 5.5 sees&lt;br&gt;redacted facts only:&lt;br&gt;hypothesis + citations +&lt;br&gt;ONE action from a closed set&lt;br&gt;≤ 6 calls · US$0.25&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="639" y="632" width="176" height="112" as="geometry" />
        </mxCell>
        <mxCell id="a6-s" value="&lt;b&gt;S5&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="781" y="623" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a6b" value="&lt;b style='font-size:12px'&gt;investigate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;≤ 2 rounds: read what&lt;br&gt;trusted evidence names,&lt;br&gt;then diagnose again&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#F7FBFE;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="439" y="643" width="176" height="84" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="&lt;b style='font-size:12px'&gt;verify (no model)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;the policies: grounding,&lt;br&gt;allow-list, blast radius,&lt;br&gt;self-target, injection...&lt;br&gt;+ one repair round&lt;br&gt;+ a second opinion&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="839" y="772" width="176" height="118" as="geometry" />
        </mxCell>
        <mxCell id="a7-s" value="&lt;b&gt;S6&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="981" y="763" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="&lt;b style='font-size:12px'&gt;plan the fix&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;plan_fix · resolve_plan&lt;br&gt;from live state: exact&lt;br&gt;plan, plan hash; one open&lt;br&gt;plan per resource&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="439" y="920" width="176" height="96" as="geometry" />
        </mxCell>
        <mxCell id="a9-s" value="&lt;b&gt;S7&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="581" y="911" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="&lt;b style='font-size:12px'&gt;gate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;bounds · cool-down&lt;br&gt;kill switch · freezes&lt;br&gt;approval-fatigue cap&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="839" y="920" width="176" height="96" as="geometry" />
        </mxCell>
        <mxCell id="a10-s" value="&lt;b&gt;S8&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="981" y="911" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="&lt;b style='font-size:12px'&gt;one Slack message&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;in the incident environment's&lt;br&gt;own alerts channel, through&lt;br&gt;the outbound gate; Review&lt;br&gt;button when a plan opened&lt;br&gt;(else the report is the end)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1039" y="1048" width="176" height="108" as="geometry" />
        </mxCell>
        <mxCell id="a8-s" value="&lt;b&gt;S9&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1181" y="1039" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="&lt;b style='font-size:12px'&gt;Approver&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;Review → approval page&lt;br&gt;Sign in with Slack, type&lt;br&gt;the target, passkey signs&lt;br&gt;the exact plan hash&lt;br&gt;(or deny; it expires)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="39" y="1176" width="176" height="118" as="geometry" />
        </mxCell>
        <mxCell id="a11-s" value="&lt;b&gt;S10&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="181" y="1167" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a12" value="&lt;b style='font-size:12px'&gt;approval Lambda&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;warden-ops-approval&lt;br&gt;signals approve_passkey&lt;br&gt;to the RemediationWorkflow&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="239" y="1176" width="176" height="118" as="geometry" />
        </mxCell>
        <mxCell id="a13" value="&lt;b style='font-size:12px'&gt;check_passkey&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;approver on the list,&lt;br&gt;signature over THIS plan,&lt;br&gt;enough approvers for&lt;br&gt;the tier&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="839" y="1176" width="176" height="118" as="geometry" />
        </mxCell>
        <mxCell id="a14" value="&lt;b style='font-size:12px'&gt;precheck&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;read the target again:&lt;br&gt;if it drifted, a new plan&lt;br&gt;goes to the approvers&lt;br&gt;(at most 2)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="439" y="1312" width="176" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a14-s" value="&lt;b&gt;S11&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="581" y="1303" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a15" value="&lt;b style='font-size:12px'&gt;apply ONCE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;re-reads approvals, precheck,&lt;br&gt;kill switch, freezes from&lt;br&gt;the audit · actor session&lt;br&gt;≤ 900 s, exact ARNs only&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFF7F5;strokeColor=#FF7E6B;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1239" y="1312" width="176" height="112" as="geometry" />
        </mxCell>
        <mxCell id="a15-s" value="&lt;b&gt;S12&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1381" y="1303" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a20" value="&lt;b style='font-size:12px'&gt;actor-use witness&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;every AssumeRole of an&lt;br&gt;actor role, from CloudTrail,&lt;br&gt;checked against the audit;&lt;br&gt;unapproved → page&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="239" y="1312" width="176" height="104" as="geometry" />
        </mxCell>
        <mxCell id="a20-s" value="&lt;b&gt;S13&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#0A9A6A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="381" y="1303" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a16" value="&lt;b style='font-size:12px'&gt;check_success&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;every 30 s; 3 healthy in&lt;br&gt;a row; alarm again = not&lt;br&gt;recovered; re-checks at&lt;br&gt;+15 and +60 min&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="439" y="1452" width="176" height="104" as="geometry" />
        </mxCell>
        <mxCell id="a17" value="&lt;b style='font-size:12px'&gt;rollback&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;if it did not recover;&lt;br&gt;a failed apply or rollback&lt;br&gt;turns the kill switch on&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFF7F5;strokeColor=#FF7E6B;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1239" y="1586" width="176" height="96" as="geometry" />
        </mxCell>
        <mxCell id="a18" value="&lt;b style='font-size:12px'&gt;finish&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;how it ended, in Slack&lt;br&gt;and on the records page&lt;br&gt;(change record if set)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1039" y="1586" width="176" height="104" as="geometry" />
        </mxCell>
        <mxCell id="a19" value="&lt;b style='font-size:12px'&gt;signed record&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52606D'&gt;every step on the hash&lt;br&gt;chain; checkpoints signed&lt;br&gt;by KMS Ed25519, anchored&lt;br&gt;in S3 Object Lock&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;fontSize=12;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="839" y="1586" width="176" height="104" as="geometry" />
