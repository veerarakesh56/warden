# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored - it holds your IP and email.
#
#   curl -s https://checkip.amazonaws.com     -> your public IP

region       = "ap-south-1"
my_ip_cidr   = "203.0.113.7/32"      # ⛔ YOUR IP. 0.0.0.0/0 is rejected by a validation rule.
budget_email = "you@example.com"     # where the $5 budget alarm goes
budget_usd   = 5

# The expensive resource: $0.10/hour for the control plane, idle or not.
enable_eks = true

# db_password is NOT set here. scripts/aws_proof.sh generates one per run and passes it with
# -var. Setting it in a file means a real credential sitting on disk after the environment is gone.
