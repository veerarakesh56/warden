# Optional overrides only. Per-environment values live in SSM Parameter Store, not here:
#   /warden/<env>/tf/my_ip_cidr    (String)        your public IP as a /32; 0.0.0.0/0 is rejected
#   /warden/<env>/tf/budget_email  (SecureString)  where the budget alarms go
# The environment is the workspace:  terraform workspace select -or-create dev
#
# eks_public_access_cidrs = ["0.0.0.0/0"]   # only for a CI runner deploying k8s
# budget_usd              = 50
