{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsInThisEnvironmentOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::${account}:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:${github_subject}:environment:${env}",
          "token.actions.githubusercontent.com:ref": "refs/heads/${env}",
          "token.actions.githubusercontent.com:job_workflow_ref": [
            "${github_repository}/.github/workflows/infra-deploy.yml@refs/heads/${env}",
            "${github_repository}/.github/workflows/demo-app-deploy.yml@refs/heads/${env}"
          ]
        }
      }
    }
  ]
}
