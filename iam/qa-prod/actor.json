{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApprovedFixesOnThisEnvironmentsResources",
      "Effect": "Allow",
      "Action": [
        "athena:StopQueryExecution",
        "dynamodb:UpdateTable",
        "ecs:UpdateService",
        "events:DisableRule",
        "events:EnableRule",
        "kinesis:IncreaseStreamRetentionPeriod",
        "lambda:DeleteFunctionConcurrency",
        "lambda:PutFunctionConcurrency",
        "lambda:UpdateAlias",
        "lambda:UpdateFunctionConfiguration",
        "rds:FailoverDBCluster",
        "sqs:CancelMessageMoveTask",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ReceiveMessage",
        "sqs:SendMessage",
        "sqs:SetQueueAttributes",
        "sqs:StartMessageMoveTask"
      ],
      "Resource": [
        "arn:aws:athena:ap-south-2:*:workgroup/warden-qa-prod-*",
        "arn:aws:dynamodb:ap-south-2:*:table/warden-qa-prod-*",
        "arn:aws:ecs:ap-south-2:*:service/warden-qa-prod-*/*",
        "arn:aws:events:ap-south-2:*:rule/warden-qa-prod-*",
        "arn:aws:kinesis:ap-south-2:*:stream/warden-qa-prod-*",
        "arn:aws:lambda:ap-south-2:*:function:warden-qa-prod-*",
        "arn:aws:rds:ap-south-2:*:cluster:warden-qa-prod-*",
        "arn:aws:rds:ap-south-2:*:db:warden-qa-prod-*",
        "arn:aws:sqs:ap-south-2:*:warden-qa-prod-*"
      ],
      "Condition": {
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "PipelineStagesOfThisEnvironment",
      "Effect": "Allow",
      "Action": [
        "codepipeline:DisableStageTransition",
        "codepipeline:EnableStageTransition"
      ],
      "Resource": "arn:aws:codepipeline:ap-south-2:*:warden-qa-prod-*/*",
      "Condition": {
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "ConfigurationDeploymentsOfThisEnvironment",
      "Effect": "Allow",
      "Action": "appconfig:StopDeployment",
      "Resource": "arn:aws:appconfig:ap-south-2:*:application/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "qa-prod"
        },
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "ZonalShiftsOfThisEnvironmentsLoadBalancers",
      "Effect": "Allow",
      "Action": [
        "arc-zonal-shift:CancelZonalShift",
        "arc-zonal-shift:StartZonalShift"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:ap-south-2:*:loadbalancer/app/warden-qa-prod-*/*",
        "arn:aws:elasticloadbalancing:ap-south-2:*:loadbalancer/net/warden-qa-prod-*/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "StageThrottlesOfThisEnvironmentsApis",
      "Effect": "Allow",
      "Action": "apigateway:PATCH",
      "Resource": "arn:aws:apigateway:ap-south-2::/restapis/*/stages/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "qa-prod"
        },
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "EventSourceMappingsOfThisEnvironmentsFunctions",
      "Effect": "Allow",
      "Action": "lambda:UpdateEventSourceMapping",
      "Resource": "arn:aws:lambda:ap-south-2:*:event-source-mapping:*",
      "Condition": {
        "ArnLike": {
          "lambda:FunctionArn": "arn:aws:lambda:ap-south-2:*:function:warden-qa-prod-*"
        },
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "SecurityGroupRulesOfThisEnvironment",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:ec2:ap-south-2:*:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "qa-prod"
        },
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "RouteTablesOfThisEnvironment",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:ReplaceRoute"
      ],
      "Resource": "arn:aws:ec2:ap-south-2:*:route-table/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "qa-prod"
        },
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "TheRuleAnAuthorizeCreates",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:ec2:ap-south-2:*:security-group-rule/*",
      "Condition": {
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "AutoScalingGroupsOfThisEnvironment",
      "Effect": "Allow",
      "Action": "autoscaling:SetDesiredCapacity",
      "Resource": "arn:aws:autoscaling:ap-south-2:*:autoScalingGroup:*:autoScalingGroupName/warden-qa-prod-*",
      "Condition": {
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "RevertsOnThisEnvironmentsTaggedResources",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DeregisterTargets",
        "elasticloadbalancing:RegisterTargets",
        "kms:CancelKeyDeletion",
        "secretsmanager:RestoreSecret"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:ap-south-2:*:targetgroup/warden-qa-prod-*/*",
        "arn:aws:kms:ap-south-2:*:key/*",
        "arn:aws:secretsmanager:ap-south-2:*:secret:warden-qa-prod-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "qa-prod"
        },
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    }
  ]
}
