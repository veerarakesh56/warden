{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadsAndCreatesThatNameNoResource",
      "Effect": "Allow",
      "Action": [
        "ecs:Describe*",
        "ecs:List*",
        "ecs:RegisterTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:CreateCluster",
        "ecs:CreateCapacityProvider",
        "ecs:TagResource",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "lambda:List*",
        "lambda:GetAccountSettings",
        "logs:Describe*",
        "logs:ListTagsForResource",
        "logs:CreateLogDelivery",
        "logs:GetLogDelivery",
        "logs:UpdateLogDelivery",
        "logs:DeleteLogDelivery",
        "logs:ListLogDeliveries",
        "cloudwatch:Describe*",
        "cloudwatch:ListTagsForResource",
        "events:Describe*",
        "events:List*",
        "sqs:ListQueues",
        "autoscaling:Describe*",
        "secretsmanager:ListSecrets",
        "kms:CreateKey",
        "kms:ListAliases",
        "apigateway:*",
        "ecr:GetAuthorizationToken",
        "cloudtrail:DescribeTrails"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2"
        }
      }
    },
    {
      "Sid": "KmsOwnKeys",
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias",
        "kms:DeleteAlias",
        "kms:UpdateAlias",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:ScheduleKeyDeletion",
        "kms:PutKeyPolicy",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags",
        "kms:DescribeKey",
        "kms:GetPublicKey"
      ],
      "Resource": [
        "arn:aws:kms:ap-south-2:*:key/*",
        "arn:aws:kms:ap-south-2:*:alias/warden-ops-*"
      ]
    },
    {
      "Sid": "OwnEnvNamedResources",
      "Effect": "Allow",
      "Action": [
        "lambda:*",
        "sqs:*",
        "events:*",
        "logs:*",
        "cloudwatch:*Alarm*",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "rds:*",
        "ecs:*",
        "autoscaling:*",
        "s3:*",
        "secretsmanager:CreateSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:TagResource",
        "secretsmanager:UntagResource",
        "secretsmanager:DeleteSecret",
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:UpdateSecret",
        "cloudtrail:*"
      ],
      "Resource": [
        "arn:aws:lambda:ap-south-2:*:function:warden-ops-*",
        "arn:aws:sqs:ap-south-2:*:warden-ops-*",
        "arn:aws:events:ap-south-2:*:rule/warden-ops-*",
        "arn:aws:logs:ap-south-2:*:log-group:/aws/lambda/warden-ops-*",
        "arn:aws:logs:ap-south-2:*:log-group:/aws/vendedlogs/warden-ops-*",
        "arn:aws:logs:ap-south-2:*:log-group:/warden/ops/*",
        "arn:aws:cloudwatch:ap-south-2:*:alarm:warden-ops-*",
        "arn:aws:rds:ap-south-2:*:cluster:warden-ops-*",
        "arn:aws:rds:ap-south-2:*:db:warden-ops-*",
        "arn:aws:rds:ap-south-2:*:subgrp:warden-ops-*",
        "arn:aws:rds:ap-south-2:*:cluster-pg:default.*",
        "arn:aws:rds:ap-south-2:*:pg:default.*",
        "arn:aws:rds:ap-south-2:*:og:default:*",
        "arn:aws:ecs:ap-south-2:*:cluster/warden-ops-*",
        "arn:aws:ecs:ap-south-2:*:service/warden-ops-*/*",
        "arn:aws:ecs:ap-south-2:*:capacity-provider/warden-ops-*",
        "arn:aws:ecs:ap-south-2:*:task-definition/warden-ops-*:*",
        "arn:aws:autoscaling:ap-south-2:*:autoScalingGroup:*:autoScalingGroupName/warden-ops-*",
        "arn:aws:s3:::warden-ops-*",
        "arn:aws:s3:::warden-ops-*/*",
        "arn:aws:secretsmanager:ap-south-2:*:secret:warden/ops/*",
        "arn:aws:cloudtrail:ap-south-2:*:trail/warden-ops-*"
      ]
    },
    {
      "Sid": "RdsManagedMasterSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:TagResource"
      ],
      "Resource": "arn:aws:secretsmanager:ap-south-2:*:secret:rds!*"
    },
    {
      "Sid": "PushTheRuntimeImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeImages",
        "ecr:GetRepositoryPolicy"
      ],
      "Resource": "arn:aws:ecr:ap-south-2:*:repository/warden-ops-*"
    },
    {
      "Sid": "IamOwnEnvRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:PutRolePermissionsBoundary",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:*InstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::*:role/warden-ops-*",
        "arn:aws:iam::*:instance-profile/warden-ops-*"
      ]
    },
    {
      "Sid": "AttachOnlyTheManagedPoliciesUsed",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::*:role/warden-ops-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole",
            "arn:aws:iam::aws:policy/service-role/AmazonEC2ContainerServiceforEC2Role",
            "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          ]
        }
      }
    },
    {
      "Sid": "PassOwnEnvRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/warden-ops-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "ecs-tasks.amazonaws.com",
            "ec2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CreateSlrs",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "rds.amazonaws.com",
            "autoscaling.amazonaws.com",
            "ops.apigateway.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadSlrs",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*"
    },
    {
      "Sid": "KmsViaServices",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey*",
        "kms:CreateGrant",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:ap-south-2:*:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "secretsmanager.ap-south-2.amazonaws.com",
            "rds.ap-south-2.amazonaws.com",
            "ssm.ap-south-2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "WhoAmI",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "OwnParametersAndTheEcsImage",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:ap-south-2:*:parameter/warden/ops/tf",
        "arn:aws:ssm:ap-south-2:*:parameter/warden/ops/tf/*",
        "arn:aws:ssm:ap-south-2::parameter/aws/service/ecs/*"
      ]
    },
    {
      "Sid": "OwnStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::warden-ops-tfstate-*",
        "arn:aws:s3:::warden-ops-tfstate-*/*"
      ]
    }
  ]
}
