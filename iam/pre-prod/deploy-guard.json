{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NeverTouchTheHandMadeRoles",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRole",
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/warden-pre-prod-actor",
        "arn:aws:iam::*:role/warden-pre-prod-platform-reader",
        "arn:aws:iam::*:role/warden-pre-prod-harness"
      ]
    },
    {
      "Sid": "OnlyBoundedRolesGetPolicies",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "iam:PermissionsBoundary": "arn:aws:iam::*:policy/WardenEnvBoundary-pre-prod"
        }
      }
    }
  ]
}
