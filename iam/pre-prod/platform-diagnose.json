{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StoppedTasksOfThisEnvironmentsClusters",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTasks",
        "ecs:ListTasks"
      ],
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "ecs:cluster": "arn:aws:ecs:ap-south-2:*:cluster/warden-pre-prod-*"
        }
      }
    },
    {
      "Sid": "NodeGroupsAndFailedExecutionsOfThisEnvironment",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeNodegroup",
        "eks:ListNodegroups",
        "states:DescribeExecution",
        "states:ListExecutions"
      ],
      "Resource": [
        "arn:aws:eks:ap-south-2:*:cluster/warden-pre-prod-*",
        "arn:aws:eks:ap-south-2:*:nodegroup/warden-pre-prod-*/*/*",
        "arn:aws:states:ap-south-2:*:stateMachine:warden-pre-prod-*",
        "arn:aws:states:ap-south-2:*:execution:warden-pre-prod-*:*"
      ]
    },
    {
      "Sid": "ReadsThatNameNoResource",
      "Effect": "Allow",
      "Action": [
        "autoscaling:DescribeScalingActivities",
        "ec2:DescribeNetworkAcls",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeSubnets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2"
        }
      }
    }
  ]
}
