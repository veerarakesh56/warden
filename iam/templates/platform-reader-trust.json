{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TheRuntimeZonesThatRead",
      "Effect": "Allow",
      "Principal": {"AWS": ["arn:aws:iam::${account}:role/warden-${runtime}-read", "arn:aws:iam::${account}:role/warden-${runtime}-notify",
                            "arn:aws:iam::${account}:role/warden-${runtime}-act"]},
      "Action": ["sts:AssumeRole", "sts:SetSourceIdentity"],
      "Condition": {"StringLike": {"sts:SourceIdentity": ["inc-*", "warden-worker"]}}
    }
  ]
}
