{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StoppedTasksOfThisEnvironmentsClusters",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTasks",
        "ecs:ListTasks"
      ],
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "ecs:cluster": "arn:aws:ecs:${region}:*:cluster/warden-${env}-*"
        }
      }
    },
    {
      "Sid": "NodeGroupsAndFailedExecutionsOfThisEnvironment",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeNodegroup",
        "eks:ListNodegroups",
        "states:DescribeExecution",
        "states:ListExecutions"
      ],
      "Resource": [
        "arn:aws:eks:${region}:*:cluster/warden-${env}-*",
        "arn:aws:eks:${region}:*:nodegroup/warden-${env}-*/*/*",
        "arn:aws:states:${region}:*:stateMachine:warden-${env}-*",
        "arn:aws:states:${region}:*:execution:warden-${env}-*:*"
      ]
    },
    {
      "Sid": "ReadsThatNameNoResource",
      "Effect": "Allow",
      "Action": [
        "autoscaling:DescribeScalingActivities",
        "config:GetResourceConfigHistory",
        "config:ListDiscoveredResources",
        "ec2:DescribeNetworkAcls",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeSubnets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}"
        }
      }
    },
    {
      "Sid": "DeploymentsOfThisEnvironmentsApis",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:${region}::/restapis/*/deployments/*"
    },
    {
      "Sid": "KeyTagsOfThisEnvironment",
      "Effect": "Allow",
      "Action": "kms:ListResourceTags",
      "Resource": "arn:aws:kms:${region}:*:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "${env}"
        }
      }
    }
  ]
}
