{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StoppedTasksOfThisEnvironmentsClusters",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTasks",
        "ecs:ListTasks"
      ],
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "ecs:cluster": "arn:aws:ecs:${region}:*:cluster/warden-${env}-*"
        }
      }
    },
    {
      "Sid": "NodeGroupsAndFailedExecutionsOfThisEnvironment",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeNodegroup",
        "eks:ListNodegroups",
        "states:DescribeExecution",
        "states:ListExecutions"
      ],
      "Resource": [
        "arn:aws:eks:${region}:*:cluster/warden-${env}-*",
        "arn:aws:eks:${region}:*:nodegroup/warden-${env}-*/*/*",
        "arn:aws:states:${region}:*:stateMachine:warden-${env}-*",
        "arn:aws:states:${region}:*:execution:warden-${env}-*:*"
      ]
    },
    {
      "Sid": "ReadsThatNameNoResource",
      "Effect": "Allow",
      "Action": [
        "autoscaling:DescribeScalingActivities",
        "ec2:DescribeNetworkAcls",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSubnets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}"
        }
      }
    }
  ]
}
