{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApprovedFixesOnThisEnvironmentsResources",
      "Effect": "Allow",
      "Action": [
        "athena:StopQueryExecution",
        "dynamodb:UpdateTable",
        "ecs:UpdateService",
        "events:DisableRule",
        "events:EnableRule",
        "lambda:PutFunctionConcurrency",
        "lambda:UpdateAlias",
        "rds:FailoverDBCluster",
        "sqs:CancelMessageMoveTask",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ReceiveMessage",
        "sqs:SendMessage",
        "sqs:StartMessageMoveTask"
      ],
      "Resource": [
        "arn:aws:athena:${region}:*:workgroup/warden-${env}-*",
        "arn:aws:dynamodb:${region}:*:table/warden-${env}-*",
        "arn:aws:ecs:${region}:*:service/warden-${env}-*/*",
        "arn:aws:events:${region}:*:rule/warden-${env}-*",
        "arn:aws:lambda:${region}:*:function:warden-${env}-*",
        "arn:aws:rds:${region}:*:cluster:warden-${env}-*",
        "arn:aws:rds:${region}:*:db:warden-${env}-*",
        "arn:aws:sqs:${region}:*:warden-${env}-*"
      ],
      "Condition": {"StringLike": {"aws:SourceIdentity": "inc-*"}}
    },
    {
      "Sid": "ZonalShiftsOfThisEnvironmentsLoadBalancers",
      "Effect": "Allow",
      "Action": ["arc-zonal-shift:CancelZonalShift", "arc-zonal-shift:StartZonalShift"],
      "Resource": [
        "arn:aws:elasticloadbalancing:${region}:*:loadbalancer/app/warden-${env}-*/*",
        "arn:aws:elasticloadbalancing:${region}:*:loadbalancer/net/warden-${env}-*/*"
      ],
      "Condition": {"StringLike": {"aws:SourceIdentity": "inc-*"}}
    },
    {
      "Sid": "StageThrottlesOfThisEnvironmentsApis",
      "Effect": "Allow",
      "Action": "apigateway:PATCH",
      "Resource": "arn:aws:apigateway:${region}::/restapis/*/stages/*",
      "Condition": {
        "StringEquals": {"aws:ResourceTag/Environment": "${env}"},
        "StringLike": {"aws:SourceIdentity": "inc-*"}
      }
    },
    {
      "Sid": "EventSourceMappingsOfThisEnvironmentsFunctions",
      "Effect": "Allow",
      "Action": "lambda:UpdateEventSourceMapping",
      "Resource": "arn:aws:lambda:${region}:*:event-source-mapping:*",
      "Condition": {
        "ArnLike": {"lambda:FunctionArn": "arn:aws:lambda:${region}:*:function:warden-${env}-*"},
        "StringLike": {"aws:SourceIdentity": "inc-*"}
      }
    }
  ]
}
