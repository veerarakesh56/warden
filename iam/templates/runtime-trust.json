{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TheRuntimePipelineOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::${account}:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:veerarakesh56/warden:environment:${env}",
          "token.actions.githubusercontent.com:ref": "refs/heads/main",
          "token.actions.githubusercontent.com:job_workflow_ref": "veerarakesh56/warden/.github/workflows/runtime.yml@refs/heads/main"
        }
      }
    }
  ]
}
