{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadsNoResource",
      "Effect": "Allow",
      "Action": [
        "rds:Describe*",
        "elasticache:Describe*",
        "elasticloadbalancing:Describe*",
        "ecs:Describe*",
        "ecs:List*",
        "eks:Describe*",
        "eks:List*",
        "autoscaling:Describe*",
        "logs:Describe*",
        "cloudwatch:Describe*",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics",
        "lambda:List*",
        "lambda:GetAccountSettings",
        "ecr:GetAuthorizationToken",
        "apigateway:GET",
        "tag:GetResources"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2"
        }
      }
    },
    {
      "Sid": "EsmAndTaskDefs",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateEventSourceMapping",
        "lambda:GetEventSourceMapping",
        "lambda:UpdateEventSourceMapping",
        "lambda:DeleteEventSourceMapping",
        "ecs:RegisterTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:DeleteTaskDefinitions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2"
        }
      }
    },
    {
      "Sid": "OwnEnvNamedResources",
      "Effect": "Allow",
      "Action": [
        "rds:*",
        "elasticache:*",
        "dynamodb:*",
        "sqs:*",
        "sns:*",
        "secretsmanager:*",
        "lambda:*",
        "events:*",
        "logs:*",
        "cloudwatch:*",
        "ecr:*",
        "ecs:*",
        "eks:*",
        "elasticloadbalancing:*",
        "apigateway:*"
      ],
      "Resource": [
        "arn:aws:rds:*:*:cluster:warden-${env}-*",
        "arn:aws:rds:*:*:db:warden-${env}-*",
        "arn:aws:rds:*:*:subgrp:warden-${env}-*",
        "arn:aws:rds:*:*:cluster-pg:default.*",
        "arn:aws:rds:*:*:pg:default.*",
        "arn:aws:rds:*:*:og:default:*",
        "arn:aws:elasticache:*:*:*:warden-${env}-*",
        "arn:aws:elasticache:*:*:parametergroup:default.*",
        "arn:aws:dynamodb:*:*:table/warden-${env}-*",
        "arn:aws:sqs:*:*:warden-${env}-*",
        "arn:aws:sns:*:*:warden-${env}-*",
        "arn:aws:secretsmanager:*:*:secret:warden-${env}-*",
        "arn:aws:lambda:*:*:function:warden-${env}-*",
        "arn:aws:events:*:*:rule/warden-${env}-*",
        "arn:aws:logs:*:*:log-group:/aws/lambda/warden-${env}-*",
        "arn:aws:logs:*:*:log-group:/ecs/warden-${env}-*",
        "arn:aws:logs:*:*:log-group:/aws/containerinsights/warden-${env}-*",
        "arn:aws:cloudwatch:*:*:alarm:warden-${env}-*",
        "arn:aws:ecr:*:*:repository/warden-${env}-*",
        "arn:aws:ecs:*:*:*/warden-${env}-*",
        "arn:aws:eks:*:*:*/warden-${env}-*",
        "arn:aws:elasticloadbalancing:*:*:*/warden-${env}-*",
        "arn:aws:apigateway:*::/apis*",
        "arn:aws:apigateway:*::/tags/*"
      ]
    },
    {
      "Sid": "IamOwnEnvRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:PutRolePermissionsBoundary",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/warden-${env}-*"
    },
    {
      "Sid": "AttachOnlyTheManagedPoliciesUsed",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::*:role/warden-${env}-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly",
            "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy",
            "arn:aws:iam::aws:policy/AmazonEKSWorkerNodePolicy",
            "arn:aws:iam::aws:policy/AmazonEKS_CNI_Policy",
            "arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy",
            "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
            "arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole",
            "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          ]
        }
      }
    },
    {
      "Sid": "PassOwnEnvRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/warden-${env}-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "ecs-tasks.amazonaws.com",
            "eks.amazonaws.com",
            "ec2.amazonaws.com",
            "pods.eks.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "AssumeOwnReader",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::*:role/warden-${env}-reader"
    },
    {
      "Sid": "CreateSlrs",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "elasticache.amazonaws.com",
            "rds.amazonaws.com",
            "eks.amazonaws.com",
            "eks-nodegroup.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "ecs.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadSlrs",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*"
    },
    {
      "Sid": "KmsViaServices",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey*",
        "kms:CreateGrant",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "secretsmanager.ap-south-2.amazonaws.com",
            "rds.ap-south-2.amazonaws.com",
            "ssm.ap-south-2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "WhoAmI",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "OwnParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/warden/${env}/tf/*"
    },
    {
      "Sid": "OwnStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::warden-${env}-tfstate-*",
        "arn:aws:s3:::warden-${env}-tfstate-*/*"
      ]
    },
    {
      "Sid": "OwnBudget",
      "Effect": "Allow",
      "Action": [
        "budgets:ViewBudget",
        "budgets:ModifyBudget",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ListTagsForResource"
      ],
      "Resource": "arn:aws:budgets::*:budget/warden-${env}-*"
    },
    {
      "Sid": "ExpressSubnetGroup",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBCluster",
        "rds:CreateDBInstance",
        "rds:EnableInternetAccessGateway"
      ],
      "Resource": "arn:aws:rds:*:*:subgrp:default"
    },
    {
      "Sid": "TagEventSourceMappings",
      "Effect": "Allow",
      "Action": [
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags"
      ],
      "Resource": "arn:aws:lambda:*:*:event-source-mapping:*"
    }
  ]
}
