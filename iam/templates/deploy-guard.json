{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NeverTouchTheHandMadeRoles",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRole",
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/warden-${env}-actor",
        "arn:aws:iam::*:role/warden-${env}-platform-reader",
        "arn:aws:iam::*:role/warden-${env}-harness"
      ]
    },
    {
      "Sid": "OnlyBoundedRolesGetPolicies",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "iam:PermissionsBoundary": "arn:aws:iam::*:policy/WardenEnvBoundary-${env}"
        }
      }
    },
    {
      "Sid": "NeverWriteTheOwnersDatadogKey",
      "Effect": "Deny",
      "NotAction": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecretVersionIds",
        "secretsmanager:GetResourcePolicy"
      ],
      "Resource": "arn:aws:secretsmanager:*:*:secret:warden-${env}-datadog-api-key*"
    },
    {
      "Sid": "NeverDeleteABackup",
      "Effect": "Deny",
      "Action": "dynamodb:DeleteBackup",
      "Resource": "*"
    }
  ]
}
