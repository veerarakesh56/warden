{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadThisEnvironmentsResources",
      "Effect": "Allow",
      "Action": [
        "athena:BatchGetQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetWorkGroup",
        "athena:ListQueryExecutions",
        "athena:ListTagsForResource",
        "cloudwatch:DescribeAlarms",
        "dynamodb:DescribeTable",
        "dynamodb:ListTagsOfResource",
        "ecs:DescribeServiceRevisions",
        "ecs:DescribeServices",
        "ecs:ListServiceDeployments",
        "eks:DescribeCluster",
        "elasticache:DescribeCacheClusters",
        "elasticache:DescribeReplicationGroups",
        "elasticache:DescribeServerlessCaches",
        "es:DescribeDomain",
        "events:DescribeRule",
        "events:ListTagsForResource",
        "firehose:DescribeDeliveryStream",
        "glue:GetJobRuns",
        "kinesis:DescribeStreamSummary",
        "lambda:GetAlias",
        "lambda:GetFunction",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionConfiguration",
        "lambda:ListTags",
        "lambda:ListVersionsByFunction",
        "memorydb:DescribeClusters",
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstances",
        "redshift:DescribeClusters",
        "s3:GetBucketVersioning",
        "scheduler:GetScheduleGroup",
        "secretsmanager:DescribeSecret",
        "sns:ListSubscriptionsByTopic",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListDeadLetterSourceQueues",
        "sqs:ListMessageMoveTasks",
        "sqs:ListQueueTags",
        "states:DescribeStateMachine",
        "synthetics:GetCanary"
      ],
      "Resource": [
        "arn:aws:athena:${region}:*:workgroup/warden-${env}-*",
        "arn:aws:cloudwatch:${region}:*:alarm:warden-${env}-*",
        "arn:aws:dynamodb:${region}:*:table/warden-${env}-*",
        "arn:aws:ecs:${region}:*:service-revision/warden-${env}-*/*/*",
        "arn:aws:ecs:${region}:*:service/warden-${env}-*/*",
        "arn:aws:eks:${region}:*:cluster/warden-${env}-*",
        "arn:aws:elasticache:${region}:*:cluster:warden-${env}-*",
        "arn:aws:elasticache:${region}:*:replicationgroup:warden-${env}-*",
        "arn:aws:elasticache:${region}:*:serverlesscache:warden-${env}-*",
        "arn:aws:es:${region}:*:domain/warden-${env}-*",
        "arn:aws:events:${region}:*:rule/warden-${env}-*",
        "arn:aws:firehose:${region}:*:deliverystream/warden-${env}-*",
        "arn:aws:glue:${region}:*:job/warden-${env}-*",
        "arn:aws:kinesis:${region}:*:stream/warden-${env}-*",
        "arn:aws:lambda:${region}:*:function:warden-${env}-*",
        "arn:aws:memorydb:${region}:*:cluster/warden-${env}-*",
        "arn:aws:rds:${region}:*:cluster:warden-${env}-*",
        "arn:aws:rds:${region}:*:db:warden-${env}-*",
        "arn:aws:redshift:${region}:*:cluster:warden-${env}-*",
        "arn:aws:s3:::warden-${env}-*",
        "arn:aws:scheduler:${region}:*:schedule-group/warden-${env}-*",
        "arn:aws:secretsmanager:${region}:*:secret:warden-${env}-*",
        "arn:aws:sns:${region}:*:warden-${env}-*",
        "arn:aws:sqs:${region}:*:warden-${env}-*",
        "arn:aws:states:${region}:*:stateMachine:warden-${env}-*",
        "arn:aws:synthetics:${region}:*:canary:warden-${env}-*"
      ]
    },
    {
      "Sid": "TheEvidenceReadersLogsOfThisEnvironment",
      "Effect": "Allow",
      "Action": [
        "logs:FilterLogEvents",
        "logs:StartQuery"
      ],
      "Resource": [
        "arn:aws:logs:${region}:*:log-group:/ecs/warden-${env}-*",
        "arn:aws:logs:${region}:*:log-group:/aws/lambda/warden-${env}-*"
      ]
    },
    {
      "Sid": "EventSourceMappingsOfThisEnvironmentsFunctions",
      "Effect": "Allow",
      "Action": "lambda:GetEventSourceMapping",
      "Resource": "arn:aws:lambda:${region}:*:event-source-mapping:*",
      "Condition": {
        "ArnLike": {
          "lambda:FunctionArn": "arn:aws:lambda:${region}:*:function:warden-${env}-*"
        }
      }
    },
    {
      "Sid": "ReadsThatNameNoResource",
      "Effect": "Allow",
      "Action": [
        "appconfig:ListApplications",
        "application-autoscaling:DescribeScalableTargets",
        "apprunner:ListServices",
        "autoscaling:DescribeAutoScalingGroups",
        "cloudtrail:LookupEvents",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeNatGateways",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeTransitGateways",
        "ec2:DescribeVolumes",
        "ecs:DescribeTaskDefinition",
        "elasticache:DescribeEvents",
        "elasticloadbalancing:DescribeInstanceHealth",
        "elasticloadbalancing:DescribeLoadBalancerAttributes",
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeTags",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetHealth",
        "kafka:ListClustersV2",
        "lambda:GetAccountSettings",
        "lambda:ListEventSourceMappings",
        "logs:GetQueryResults",
        "logs:StopQuery",
        "mq:ListBrokers",
        "pi:GetResourceMetrics",
        "rds:DescribeEvents",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}"
        }
      }
    },
    {
      "Sid": "IdNamedResourcesOfThisEnvironment",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "appconfig:ListDeployments",
        "appconfig:ListEnvironments",
        "appconfig:ListTagsForResource",
        "appsync:GetGraphqlApi",
        "cognito-idp:DescribeUserPool",
        "elasticfilesystem:DescribeFileSystems",
        "elasticmapreduce:DescribeCluster",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "${env}",
          "aws:RequestedRegion": "${region}"
        }
      }
    },
    {
      "Sid": "TheApiListingsOnly",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": [
        "arn:aws:apigateway:${region}::/restapis",
        "arn:aws:apigateway:${region}::/apis",
        "arn:aws:apigateway:${region}::/apis/*"
      ]
    },
    {
      "Sid": "ZonalShiftStateOfThisEnvironmentsLoadBalancers",
      "Effect": "Allow",
      "Action": "arc-zonal-shift:GetManagedResource",
      "Resource": [
        "arn:aws:elasticloadbalancing:${region}:*:loadbalancer/app/warden-${env}-*/*",
        "arn:aws:elasticloadbalancing:${region}:*:loadbalancer/net/warden-${env}-*/*"
      ]
    },
    {
      "Sid": "StagesOfThisEnvironmentsApis",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:${region}::/restapis/*/stages/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/Environment": "${env}"}}
    },
    {
      "Sid": "TheAccountsThrottle",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:${region}::/account"
    },
    {
      "Sid": "NeverApiKeys",
      "Effect": "Deny",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:*::/apikeys*"
    }
  ]
}
