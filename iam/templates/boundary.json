{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CeilingRegional",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "ecs:*",
        "ecr:*",
        "eks:*",
        "eks-auth:AssumeRoleForPodIdentity",
        "rds:*",
        "logs:*",
        "cloudwatch:*",
        "elasticloadbalancing:*",
        "lambda:*",
        "sqs:*",
        "autoscaling:*",
        "application-autoscaling:*",
        "events:*",
        "tag:*",
        "kms:DescribeKey",
        "pi:Get*",
        "kms:ListAliases",
        "elasticache:Describe*",
        "apigateway:GET",
        "secretsmanager:ListSecrets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}"
        }
      }
    },
    {
      "Sid": "CeilingOwnNames",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "dynamodb:*",
        "sns:*",
        "secretsmanager:*",
        "elasticache:*",
        "apigateway:*",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "budgets:ViewBudget",
        "budgets:ModifyBudget",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ListTagsForResource",
        "rds-db:connect"
      ],
      "Resource": [
        "arn:aws:s3:::warden-${env}-*",
        "arn:aws:s3:::warden-${env}-*/*",
        "arn:aws:dynamodb:${region}:*:table/warden-${env}-*",
        "arn:aws:sns:${region}:*:warden-${env}-*",
        "arn:aws:secretsmanager:${region}:*:secret:warden-${env}-*",
        "arn:aws:elasticache:${region}:*:*:warden-${env}-*",
        "arn:aws:elasticache:${region}:*:parametergroup:default.*",
        "arn:aws:apigateway:${region}::/apis*",
        "arn:aws:apigateway:${region}::/tags/*",
        "arn:aws:ssm:${region}:*:parameter/warden/${env}/tf/*",
        "arn:aws:budgets::*:budget/warden-${env}-*",
        "arn:aws:rds-db:${region}:*:dbuser:*/warden_${env_sql}_*"
      ]
    },
    {
      "Sid": "CeilingKms",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey*",
        "kms:CreateGrant"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "secretsmanager.${region}.amazonaws.com",
            "rds.${region}.amazonaws.com",
            "ssm.${region}.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CeilingIam",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:List*",
        "iam:*InstanceProfile",
        "iam:PassRole",
        "sts:AssumeRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/warden-${env}-*",
        "arn:aws:iam::*:instance-profile/warden-${env}-*"
      ]
    },
    {
      "Sid": "CeilingCreateSlrs",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "eks.amazonaws.com",
            "eks-nodegroup.amazonaws.com",
            "rds.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "autoscaling.amazonaws.com",
            "elasticache.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CeilingReadSlrs",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*"
    },
    {
      "Sid": "CeilingWhoAmI",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "DenyRoleWithoutThisBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "iam:PermissionsBoundary": "arn:aws:iam::*:policy/WardenEnvBoundary-${env}"
        }
      }
    },
    {
      "Sid": "DenyAlways",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "rds:DeleteDBSnapshot",
        "rds:DeleteDBClusterSnapshot",
        "ec2:Run*",
        "ec2:RequestSpot*",
        "ec2:Purchase*",
        "ec2:CreateFleet",
        "ec2:AllocateHosts",
        "ecs:RunTask",
        "ecs:StartTask",
        "s3:Put*PublicAccessBlock",
        "s3:Put*Acl",
        "s3:PutBucketPolicy",
        "rds:Modify*SnapshotAttribute",
        "ec2:ModifySnapshotAttribute",
        "ec2:ModifyImageAttribute",
        "secretsmanager:PutResourcePolicy",
        "ecr:SetRepositoryPolicy",
        "logs:*ResourcePolicy",
        "logs:PutSubscriptionFilter",
        "logs:PutDestination*",
        "events:Put*P*",
        "ecr:PutRe*",
        "logs:*AccountPolicy",
        "ec2:*BlockPublicAccess*",
        "ec2:*Ebs*Default*",
        "ec2:*MetadataDefaults",
        "ecs:PutAccountSetting*",
        "ecr:*CreationTemplate",
        "ec2:Accept*",
        "ec2:CreateVpcPeering*",
        "ec2:*ServicePermissions",
        "lambda:AddLayer*",
        "sqs:AddPermission",
        "sns:AddPermission",
        "rds:Purchase*",
        "elasticache:Purchase*",
        "ec2:*CapacityReservation*",
        "eks:*Subscription*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenySelfEdit",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::*:role/warden-${env}-deploy"
    },
    {
      "Sid": "DenyOtherEnvResources",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Environment": "${env}"
        },
        "Null": {
          "aws:ResourceTag/Environment": "false"
        }
      }
    },
    {
      "Sid": "DenyOtherEnvTags",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestTag/Environment": "${env}"
        },
        "Null": {
          "aws:RequestTag/Environment": "false"
        }
      }
    },
    {
      "Sid": "DenyUntaggedNet",
      "Effect": "Deny",
      "Action": [
        "ec2:*NetworkAclEntry",
        "ec2:*SecurityGroup*gress",
        "ec2:ModifySecurityGroupRules",
        "ec2:*Route"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:*/acl-*",
        "arn:aws:ec2:*:*:*/sg-*",
        "arn:aws:ec2:*:*:*/rtb-*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/Environment": "true"
        }
      }
    },
    {
      "Sid": "DenyDestroyingOthers",
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBCluster",
        "rds:DeleteDBInstance",
        "dynamodb:DeleteTable",
        "secretsmanager:DeleteSecret",
        "secretsmanager:PutSecretValue",
        "s3:DeleteBucket"
      ],
      "NotResource": [
        "arn:aws:rds:*:*:cluster:warden-${env}-*",
        "arn:aws:rds:*:*:db:warden-${env}-*",
        "arn:aws:dynamodb:*:*:table/warden-${env}-*",
        "arn:aws:secretsmanager:*:*:secret:warden-${env}-*",
        "arn:aws:s3:::warden-${env}-*"
      ]
    },
    {
      "Sid": "DenyOtherClusters",
      "Effect": "Deny",
      "Action": [
        "ecs:*Service",
        "ecs:*Task",
        "ecs:*TaskSet",
        "ecs:*Daemon"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "ecs:cluster": "arn:aws:ecs:*:*:cluster/warden-${env}-*"
        }
      }
    },
    {
      "Sid": "DenyFnUrls",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "NONE"
        }
      }
    },
    {
      "Sid": "DenyInvokeByAll",
      "Effect": "Deny",
      "Action": "lambda:AddPermission",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "lambda:Principal": [
            "events.amazonaws.com",
            "apigateway.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyMasterDb",
      "Effect": "Deny",
      "Action": "rds-db:connect",
      "Resource": "arn:aws:rds-db:*:*:dbuser:*/postgres"
    }
  ]
}
