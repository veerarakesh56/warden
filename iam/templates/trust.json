{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsInThisEnvironmentOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::${account}:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:veerarakesh56/warden:environment:${env}"
        }
      }
    },
    {
      "Sid": "TheOperator",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::${account}:user/warden-operator"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
