{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StoppedTasksOfThisEnvironmentsClusters",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTasks",
        "ecs:ListTasks"
      ],
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "ecs:cluster": "arn:aws:ecs:ap-south-2:*:cluster/warden-qa-staging-*"
        }
      }
    },
    {
      "Sid": "NodeGroupsAndFailedExecutionsOfThisEnvironment",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeNodegroup",
        "eks:ListNodegroups",
        "states:DescribeExecution",
        "states:ListExecutions"
      ],
      "Resource": [
        "arn:aws:eks:ap-south-2:*:cluster/warden-qa-staging-*",
        "arn:aws:eks:ap-south-2:*:nodegroup/warden-qa-staging-*/*/*",
        "arn:aws:states:ap-south-2:*:stateMachine:warden-qa-staging-*",
        "arn:aws:states:ap-south-2:*:execution:warden-qa-staging-*:*"
      ]
    },
    {
      "Sid": "ReadsThatNameNoResource",
      "Effect": "Allow",
      "Action": [
        "autoscaling:DescribeScalingActivities",
        "config:GetResourceConfigHistory",
        "config:ListDiscoveredResources",
        "ec2:DescribeNetworkAcls",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeSubnets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2"
        }
      }
    },
    {
      "Sid": "DeploymentsOfThisEnvironmentsApis",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:ap-south-2::/restapis/*/deployments/*"
    },
    {
      "Sid": "KeyTagsOfThisEnvironment",
      "Effect": "Allow",
      "Action": "kms:ListResourceTags",
      "Resource": "arn:aws:kms:ap-south-2:*:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "qa-staging"
        }
      }
    },
    {
      "Sid": "GlobalServicesAlarmsOfThisEnvironment",
      "Effect": "Allow",
      "Action": "cloudwatch:DescribeAlarms",
      "Resource": "arn:aws:cloudwatch:us-east-1:*:alarm:warden-qa-staging-*"
    },
    {
      "Sid": "GlobalServicesMetricsAndChanges",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:LookupEvents",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "SubscribersOfThisEnvironment",
      "Effect": "Allow",
      "Action": "events:DescribeSubscriber",
      "Resource": "arn:aws:events:ap-south-2:*:subscriber/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "qa-staging"
        }
      }
    },
    {
      "Sid": "StreamTagsOfThisEnvironment",
      "Effect": "Allow",
      "Action": "kinesis:ListTagsForStream",
      "Resource": "arn:aws:kinesis:ap-south-2:*:stream/warden-qa-staging-*"
    },
    {
      "Sid": "GlobalServicesDistributionsOfThisEnvironment",
      "Effect": "Allow",
      "Action": "cloudfront:GetDistribution",
      "Resource": "arn:aws:cloudfront::*:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "qa-staging"
        }
      }
    },
    {
      "Sid": "GlobalServicesHealthCheckStatus",
      "Effect": "Allow",
      "Action": "route53:GetHealthCheckStatus",
      "Resource": "arn:aws:route53:::healthcheck/*"
    }
  ]
}
