{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadThisEnvironmentsResources",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:ListTagsOfResource",
        "ecs:DescribeServiceRevisions",
        "ecs:DescribeServices",
        "ecs:ListServiceDeployments",
        "events:DescribeRule",
        "events:ListTagsForResource",
        "lambda:GetAlias",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionConfiguration",
        "lambda:ListTags",
        "lambda:ListVersionsByFunction",
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstances"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-2:*:table/warden-qa-staging-*",
        "arn:aws:ecs:ap-south-2:*:service/warden-qa-staging-*/*",
        "arn:aws:ecs:ap-south-2:*:service-revision/warden-qa-staging-*/*/*",
        "arn:aws:events:ap-south-2:*:rule/warden-qa-staging-*",
        "arn:aws:lambda:ap-south-2:*:function:warden-qa-staging-*",
        "arn:aws:rds:ap-south-2:*:cluster:warden-qa-staging-*",
        "arn:aws:rds:ap-south-2:*:db:warden-qa-staging-*"
      ]
    },
    {
      "Sid": "TheEvidenceReadersLogsOfThisEnvironment",
      "Effect": "Allow",
      "Action": "logs:FilterLogEvents",
      "Resource": [
        "arn:aws:logs:ap-south-2:*:log-group:/ecs/warden-qa-staging-*",
        "arn:aws:logs:ap-south-2:*:log-group:/aws/lambda/warden-qa-staging-*"
      ]
    },
    {
      "Sid": "EventSourceMappingsOfThisEnvironmentsFunctions",
      "Effect": "Allow",
      "Action": "lambda:GetEventSourceMapping",
      "Resource": "arn:aws:lambda:ap-south-2:*:event-source-mapping:*",
      "Condition": {
        "ArnLike": {
          "lambda:FunctionArn": "arn:aws:lambda:ap-south-2:*:function:warden-qa-staging-*"
        }
      }
    },
    {
      "Sid": "ReadsThatNameNoResource",
      "Effect": "Allow",
      "Action": [
        "application-autoscaling:DescribeScalableTargets",
        "cloudtrail:LookupEvents",
        "cloudwatch:GetMetricData",
        "ecs:DescribeTaskDefinition",
        "lambda:GetAccountSettings"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2"
        }
      }
    }
  ]
}
