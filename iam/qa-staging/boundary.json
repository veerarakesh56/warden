{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CeilingRegional",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "ecs:*",
        "ecr:*",
        "eks:*",
        "eks-auth:AssumeRoleForPodIdentity",
        "rds:*",
        "rds-db:connect",
        "logs:*",
        "cloudwatch:*",
        "elasticloadbalancing:*",
        "lambda:*",
        "sqs:*",
        "autoscaling:*",
        "application-autoscaling:*",
        "events:*",
        "tag:*",
        "kms:DescribeKey",
        "kms:ListAliases",
        "elasticache:Describe*",
        "apigateway:GET",
        "secretsmanager:ListSecrets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2"
        }
      }
    },
    {
      "Sid": "CeilingOwnNames",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "dynamodb:*",
        "sns:*",
        "secretsmanager:*",
        "elasticache:*",
        "apigateway:*"
      ],
      "Resource": [
        "arn:aws:s3:::warden-qa-staging-*",
        "arn:aws:s3:::warden-qa-staging-*/*",
        "arn:aws:dynamodb:ap-south-2:*:table/warden-qa-staging-*",
        "arn:aws:sns:ap-south-2:*:warden-qa-staging-*",
        "arn:aws:secretsmanager:ap-south-2:*:secret:warden-qa-staging-*",
        "arn:aws:elasticache:ap-south-2:*:*:warden-qa-staging-*",
        "arn:aws:elasticache:ap-south-2:*:parametergroup:default.*",
        "arn:aws:apigateway:ap-south-2::/apis*",
        "arn:aws:apigateway:ap-south-2::/tags/*"
      ]
    },
    {
      "Sid": "CeilingOwnParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:ap-south-2:*:parameter/warden/qa-staging/*"
    },
    {
      "Sid": "CeilingKmsViaServices",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey*",
        "kms:CreateGrant"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "secretsmanager.ap-south-2.amazonaws.com",
            "rds.ap-south-2.amazonaws.com",
            "ssm.ap-south-2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CeilingIamOwnEnv",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::*:role/warden-qa-staging-*",
        "arn:aws:iam::*:instance-profile/warden-qa-staging-*"
      ]
    },
    {
      "Sid": "CeilingPassAssumeOwnEnv",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "sts:AssumeRole"
      ],
      "Resource": "arn:aws:iam::*:role/warden-qa-staging-*"
    },
    {
      "Sid": "CeilingCreateSlrs",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "eks.amazonaws.com",
            "eks-nodegroup.amazonaws.com",
            "rds.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "autoscaling.amazonaws.com",
            "elasticache.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CeilingReadSlrs",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*"
    },
    {
      "Sid": "CeilingOwnBudget",
      "Effect": "Allow",
      "Action": [
        "budgets:ViewBudget",
        "budgets:ModifyBudget",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ListTagsForResource"
      ],
      "Resource": "arn:aws:budgets::*:budget/warden-qa-staging-*"
    },
    {
      "Sid": "CeilingWhoAmI",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "DenyRoleWithoutThisBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "iam:PermissionsBoundary": "arn:aws:iam::*:policy/WardenEnvBoundary-qa-staging"
        }
      }
    },
    {
      "Sid": "DenyBoundaryRemoval",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": "*"
    },
    {
      "Sid": "DenySelfEdit",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::*:role/warden-qa-staging-deploy"
    },
    {
      "Sid": "DenyOtherEnvResources",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Environment": "qa-staging"
        },
        "Null": {
          "aws:ResourceTag/Environment": "false"
        }
      }
    },
    {
      "Sid": "DenyOtherEnvTags",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestTag/Environment": "qa-staging"
        },
        "Null": {
          "aws:RequestTag/Environment": "false"
        }
      }
    },
    {
      "Sid": "DenyDestroyingOthers",
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBCluster",
        "rds:DeleteDBInstance",
        "dynamodb:DeleteTable",
        "secretsmanager:DeleteSecret",
        "secretsmanager:PutSecretValue",
        "s3:DeleteBucket"
      ],
      "NotResource": [
        "arn:aws:rds:ap-south-2:*:cluster:warden-qa-staging-*",
        "arn:aws:rds:ap-south-2:*:db:warden-qa-staging-*",
        "arn:aws:dynamodb:ap-south-2:*:table/warden-qa-staging-*",
        "arn:aws:secretsmanager:ap-south-2:*:secret:warden-qa-staging-*",
        "arn:aws:s3:::warden-qa-staging-*"
      ]
    },
    {
      "Sid": "DenyDeletingSnapshots",
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBSnapshot",
        "rds:DeleteDBClusterSnapshot"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyCompute",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:RequestSpotInstances",
        "ec2:RequestSpotFleet",
        "ec2:CreateFleet",
        "ec2:RunScheduledInstances",
        "ec2:PurchaseReservedInstancesOffering",
        "ec2:PurchaseHostReservation",
        "ec2:AllocateHosts"
      ],
      "Resource": "*"
    }
  ]
}
