{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WhoAmI",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "CheckPoliciesWithAwsOwnEvaluator",
      "Effect": "Allow",
      "Action": [
        "access-analyzer:ValidatePolicy",
        "access-analyzer:CheckNoNewAccess",
        "access-analyzer:CheckAccessNotGranted",
        "iam:SimulateCustomPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SweepEveryRegionReadOnly",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole",
        "sts:SetSourceIdentity"
      ],
      "Resource": "arn:aws:iam::*:role/warden-ops-sweep",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "${aws:PrincipalAccount}"
        }
      }
    },
    {
      "Sid": "RunTheBenchmarkHarnessInDevOnly",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole",
        "sts:SetSourceIdentity"
      ],
      "Resource": "arn:aws:iam::*:role/warden-dev-harness",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "${aws:PrincipalAccount}"
        }
      }
    },
    {
      "Sid": "ReadWhatTheOwnerPastedToCompareWithTheRepo",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions"
      ],
      "Resource": [
        "arn:aws:iam::*:role/warden-*",
        "arn:aws:iam::*:policy/Warden*"
      ]
    },
    {
      "Sid": "SeeThatTheOldUserAndItsKeyAreGone",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:ListAccessKeys",
        "iam:ListAttachedUserPolicies"
      ],
      "Resource": "arn:aws:iam::*:user/warden-operator"
    },
    {
      "Sid": "ReadRolesAnywhereSetup",
      "Effect": "Allow",
      "Action": [
        "rolesanywhere:GetTrustAnchor",
        "rolesanywhere:ListTrustAnchors",
        "rolesanywhere:GetProfile",
        "rolesanywhere:ListProfiles",
        "rolesanywhere:ListSubjects",
        "rolesanywhere:GetSubject"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2"
        }
      }
    },
    {
      "Sid": "FreePlanEndDateAndCredits",
      "Effect": "Allow",
      "Action": "freetier:GetAccountPlanState",
      "Resource": "*"
    },
    {
      "Sid": "SeeTheOpsSecretsNeverTheirValues",
      "Effect": "Allow",
      "Action": "secretsmanager:DescribeSecret",
      "Resource": "arn:aws:secretsmanager:ap-south-2:*:secret:warden/ops/*"
    }
  ]
}
