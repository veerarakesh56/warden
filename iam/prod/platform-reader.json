{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadThisEnvironmentsResources",
      "Effect": "Allow",
      "Action": [
        "athena:BatchGetQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetWorkGroup",
        "athena:ListQueryExecutions",
        "athena:ListTagsForResource",
        "cloudwatch:DescribeAlarms",
        "dynamodb:DescribeTable",
        "dynamodb:ListTagsOfResource",
        "ecs:DescribeServiceRevisions",
        "ecs:DescribeServices",
        "ecs:ListServiceDeployments",
        "eks:DescribeCluster",
        "elasticache:DescribeCacheClusters",
        "elasticache:DescribeReplicationGroups",
        "elasticache:DescribeServerlessCaches",
        "es:DescribeDomain",
        "events:DescribeRule",
        "events:ListTagsForResource",
        "firehose:DescribeDeliveryStream",
        "glue:GetJobRuns",
        "kinesis:DescribeStreamSummary",
        "lambda:GetAlias",
        "lambda:GetFunction",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionConfiguration",
        "lambda:ListTags",
        "lambda:ListVersionsByFunction",
        "memorydb:DescribeClusters",
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstances",
        "redshift:DescribeClusters",
        "s3:GetBucketVersioning",
        "scheduler:GetScheduleGroup",
        "secretsmanager:DescribeSecret",
        "sns:ListSubscriptionsByTopic",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListDeadLetterSourceQueues",
        "sqs:ListMessageMoveTasks",
        "sqs:ListQueueTags",
        "states:DescribeStateMachine",
        "synthetics:GetCanary"
      ],
      "Resource": [
        "arn:aws:athena:ap-south-2:*:workgroup/warden-prod-*",
        "arn:aws:cloudwatch:ap-south-2:*:alarm:warden-prod-*",
        "arn:aws:dynamodb:ap-south-2:*:table/warden-prod-*",
        "arn:aws:ecs:ap-south-2:*:service-revision/warden-prod-*/*/*",
        "arn:aws:ecs:ap-south-2:*:service/warden-prod-*/*",
        "arn:aws:eks:ap-south-2:*:cluster/warden-prod-*",
        "arn:aws:elasticache:ap-south-2:*:cluster:warden-prod-*",
        "arn:aws:elasticache:ap-south-2:*:replicationgroup:warden-prod-*",
        "arn:aws:elasticache:ap-south-2:*:serverlesscache:warden-prod-*",
        "arn:aws:es:ap-south-2:*:domain/warden-prod-*",
        "arn:aws:events:ap-south-2:*:rule/warden-prod-*",
        "arn:aws:firehose:ap-south-2:*:deliverystream/warden-prod-*",
        "arn:aws:glue:ap-south-2:*:job/warden-prod-*",
        "arn:aws:kinesis:ap-south-2:*:stream/warden-prod-*",
        "arn:aws:lambda:ap-south-2:*:function:warden-prod-*",
        "arn:aws:memorydb:ap-south-2:*:cluster/warden-prod-*",
        "arn:aws:rds:ap-south-2:*:cluster:warden-prod-*",
        "arn:aws:rds:ap-south-2:*:db:warden-prod-*",
        "arn:aws:redshift:ap-south-2:*:cluster:warden-prod-*",
        "arn:aws:s3:::warden-prod-*",
        "arn:aws:scheduler:ap-south-2:*:schedule-group/warden-prod-*",
        "arn:aws:secretsmanager:ap-south-2:*:secret:warden-prod-*",
        "arn:aws:sns:ap-south-2:*:warden-prod-*",
        "arn:aws:sqs:ap-south-2:*:warden-prod-*",
        "arn:aws:states:ap-south-2:*:stateMachine:warden-prod-*",
        "arn:aws:synthetics:ap-south-2:*:canary:warden-prod-*"
      ]
    },
    {
      "Sid": "TheEvidenceReadersLogsOfThisEnvironment",
      "Effect": "Allow",
      "Action": [
        "logs:FilterLogEvents",
        "logs:StartQuery"
      ],
      "Resource": [
        "arn:aws:logs:ap-south-2:*:log-group:/ecs/warden-prod-*",
        "arn:aws:logs:ap-south-2:*:log-group:/aws/lambda/warden-prod-*"
      ]
    },
    {
      "Sid": "EventSourceMappingsOfThisEnvironmentsFunctions",
      "Effect": "Allow",
      "Action": "lambda:GetEventSourceMapping",
      "Resource": "arn:aws:lambda:ap-south-2:*:event-source-mapping:*",
      "Condition": {
        "ArnLike": {
          "lambda:FunctionArn": "arn:aws:lambda:ap-south-2:*:function:warden-prod-*"
        }
      }
    },
    {
      "Sid": "ReadsThatNameNoResource",
      "Effect": "Allow",
      "Action": [
        "application-autoscaling:DescribeScalableTargets",
        "apprunner:ListServices",
        "autoscaling:DescribeAutoScalingGroups",
        "cloudtrail:LookupEvents",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeNatGateways",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeTransitGateways",
        "ec2:DescribeVolumes",
        "ecs:DescribeTaskDefinition",
        "elasticache:DescribeEvents",
        "elasticloadbalancing:DescribeInstanceHealth",
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetHealth",
        "kafka:ListClustersV2",
        "lambda:GetAccountSettings",
        "lambda:ListEventSourceMappings",
        "logs:GetQueryResults",
        "logs:StopQuery",
        "mq:ListBrokers",
        "pi:GetResourceMetrics",
        "rds:DescribeEvents",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2"
        }
      }
    },
    {
      "Sid": "IdNamedResourcesOfThisEnvironment",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "appsync:GetGraphqlApi",
        "cognito-idp:DescribeUserPool",
        "elasticfilesystem:DescribeFileSystems",
        "elasticmapreduce:DescribeCluster",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "prod",
          "aws:RequestedRegion": "ap-south-2"
        }
      }
    },
    {
      "Sid": "TheApiListingsOnly",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": [
        "arn:aws:apigateway:ap-south-2::/restapis",
        "arn:aws:apigateway:ap-south-2::/apis",
        "arn:aws:apigateway:ap-south-2::/apis/*"
      ]
    },
    {
      "Sid": "StagesOfThisEnvironmentsApis",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:ap-south-2::/restapis/*/stages/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "prod"
        }
      }
    },
    {
      "Sid": "TheAccountsThrottle",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:ap-south-2::/account"
    },
    {
      "Sid": "NeverApiKeys",
      "Effect": "Deny",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:*::/apikeys*"
    }
  ]
}
