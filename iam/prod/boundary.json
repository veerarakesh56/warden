{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CeilingRegional",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "ecs:*",
        "ecr:*",
        "eks:*",
        "eks-auth:AssumeRoleForPodIdentity",
        "rds:*",
        "logs:*",
        "cloudwatch:*",
        "elasticloadbalancing:*",
        "lambda:*",
        "sqs:*",
        "autoscaling:*",
        "application-autoscaling:*",
        "events:*",
        "tag:*",
        "kms:DescribeKey",
        "kms:ListAliases",
        "elasticache:Describe*",
        "apigateway:GET",
        "secretsmanager:ListSecrets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2"
        }
      }
    },
    {
      "Sid": "CeilingOwnDbUsers",
      "Effect": "Allow",
      "Action": "rds-db:connect",
      "Resource": "arn:aws:rds-db:ap-south-2:*:dbuser:*/warden_prod_*"
    },
    {
      "Sid": "CeilingOwnNames",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "dynamodb:*",
        "sns:*",
        "secretsmanager:*",
        "elasticache:*",
        "apigateway:*"
      ],
      "Resource": [
        "arn:aws:s3:::warden-prod-*",
        "arn:aws:s3:::warden-prod-*/*",
        "arn:aws:dynamodb:ap-south-2:*:table/warden-prod-*",
        "arn:aws:sns:ap-south-2:*:warden-prod-*",
        "arn:aws:secretsmanager:ap-south-2:*:secret:warden-prod-*",
        "arn:aws:elasticache:ap-south-2:*:*:warden-prod-*",
        "arn:aws:elasticache:ap-south-2:*:parametergroup:default.*",
        "arn:aws:apigateway:ap-south-2::/apis*",
        "arn:aws:apigateway:ap-south-2::/tags/*"
      ]
    },
    {
      "Sid": "CeilingOwnParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:ap-south-2:*:parameter/warden/prod/tf/*"
    },
    {
      "Sid": "CeilingKmsViaServices",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey*",
        "kms:CreateGrant"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "secretsmanager.ap-south-2.amazonaws.com",
            "rds.ap-south-2.amazonaws.com",
            "ssm.ap-south-2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CeilingIamOwnEnv",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:List*",
        "iam:*InstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::*:role/warden-prod-*",
        "arn:aws:iam::*:instance-profile/warden-prod-*"
      ]
    },
    {
      "Sid": "CeilingPassAssumeOwnEnv",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "sts:AssumeRole"
      ],
      "Resource": "arn:aws:iam::*:role/warden-prod-*"
    },
    {
      "Sid": "CeilingCreateSlrs",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "eks.amazonaws.com",
            "eks-nodegroup.amazonaws.com",
            "rds.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "autoscaling.amazonaws.com",
            "elasticache.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CeilingReadSlrs",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*"
    },
    {
      "Sid": "CeilingOwnBudget",
      "Effect": "Allow",
      "Action": [
        "budgets:ViewBudget",
        "budgets:ModifyBudget",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ListTagsForResource"
      ],
      "Resource": "arn:aws:budgets::*:budget/warden-prod-*"
    },
    {
      "Sid": "CeilingWhoAmI",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "DenyRoleWithoutThisBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "iam:PermissionsBoundary": "arn:aws:iam::*:policy/WardenEnvBoundary-prod"
        }
      }
    },
    {
      "Sid": "DenyBoundaryRemoval",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": "*"
    },
    {
      "Sid": "DenySelfEdit",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::*:role/warden-prod-deploy"
    },
    {
      "Sid": "DenyOtherEnvResources",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Environment": "prod"
        },
        "Null": {
          "aws:ResourceTag/Environment": "false"
        }
      }
    },
    {
      "Sid": "DenyOtherEnvTags",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestTag/Environment": "prod"
        },
        "Null": {
          "aws:RequestTag/Environment": "false"
        }
      }
    },
    {
      "Sid": "DenyDestroyingOthers",
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBCluster",
        "rds:DeleteDBInstance",
        "dynamodb:DeleteTable",
        "secretsmanager:DeleteSecret",
        "secretsmanager:PutSecretValue",
        "s3:DeleteBucket"
      ],
      "NotResource": [
        "arn:aws:rds:*:*:cluster:warden-prod-*",
        "arn:aws:rds:*:*:db:warden-prod-*",
        "arn:aws:dynamodb:*:*:table/warden-prod-*",
        "arn:aws:secretsmanager:*:*:secret:warden-prod-*",
        "arn:aws:s3:::warden-prod-*"
      ]
    },
    {
      "Sid": "DenyOtherClusters",
      "Effect": "Deny",
      "Action": [
        "ecs:*Service",
        "ecs:*Task",
        "ecs:*TaskSet"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "ecs:cluster": "arn:aws:ecs:*:*:cluster/warden-prod-*"
        }
      }
    },
    {
      "Sid": "DenyDeletingSnapshots",
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBSnapshot",
        "rds:DeleteDBClusterSnapshot"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyCompute",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:RequestSpotInstances",
        "ec2:RequestSpotFleet",
        "ec2:CreateFleet",
        "ec2:RunScheduledInstances",
        "ec2:PurchaseReservedInstancesOffering",
        "ec2:PurchaseHostReservation",
        "ec2:AllocateHosts"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyPublicData",
      "Effect": "Deny",
      "Action": [
        "s3:Put*PublicAccessBlock",
        "s3:DeleteBucketPublicAccessBlock",
        "s3:PutBucketAcl",
        "s3:PutObjectAcl",
        "s3:PutBucketPolicy",
        "rds:Modify*SnapshotAttribute",
        "ec2:ModifySnapshotAttribute",
        "ec2:ModifyImageAttribute",
        "secretsmanager:PutResourcePolicy",
        "ecr:SetRepositoryPolicy",
        "logs:PutResourcePolicy",
        "logs:PutSubscriptionFilter",
        "logs:PutDestination*",
        "events:PutPermission",
        "ecr:PutRe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyPublicFnUrls",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "NONE"
        }
      }
    },
    {
      "Sid": "DenyInvokeByAll",
      "Effect": "Deny",
      "Action": "lambda:AddPermission",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "lambda:Principal": "*"
        }
      }
    },
    {
      "Sid": "DenyMasterDbLogin",
      "Effect": "Deny",
      "Action": "rds-db:connect",
      "Resource": "arn:aws:rds-db:*:*:dbuser:*/postgres"
    }
  ]
}
