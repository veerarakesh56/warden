{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApprovedFixesOnThisEnvironmentsResources",
      "Effect": "Allow",
      "Action": [
        "athena:StopQueryExecution",
        "dynamodb:UpdateTable",
        "ecs:UpdateService",
        "events:DisableRule",
        "events:EnableRule",
        "lambda:PutFunctionConcurrency",
        "lambda:UpdateAlias",
        "rds:FailoverDBCluster",
        "sqs:CancelMessageMoveTask",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ReceiveMessage",
        "sqs:SendMessage",
        "sqs:StartMessageMoveTask"
      ],
      "Resource": [
        "arn:aws:athena:ap-south-2:*:workgroup/warden-dev-*",
        "arn:aws:dynamodb:ap-south-2:*:table/warden-dev-*",
        "arn:aws:ecs:ap-south-2:*:service/warden-dev-*/*",
        "arn:aws:events:ap-south-2:*:rule/warden-dev-*",
        "arn:aws:lambda:ap-south-2:*:function:warden-dev-*",
        "arn:aws:rds:ap-south-2:*:cluster:warden-dev-*",
        "arn:aws:rds:ap-south-2:*:db:warden-dev-*",
        "arn:aws:sqs:ap-south-2:*:warden-dev-*"
      ],
      "Condition": {
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "PipelineStagesOfThisEnvironment",
      "Effect": "Allow",
      "Action": [
        "codepipeline:DisableStageTransition",
        "codepipeline:EnableStageTransition"
      ],
      "Resource": "arn:aws:codepipeline:ap-south-2:*:warden-dev-*/*",
      "Condition": {
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "ConfigurationDeploymentsOfThisEnvironment",
      "Effect": "Allow",
      "Action": "appconfig:StopDeployment",
      "Resource": "arn:aws:appconfig:ap-south-2:*:application/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "dev"
        },
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "ZonalShiftsOfThisEnvironmentsLoadBalancers",
      "Effect": "Allow",
      "Action": [
        "arc-zonal-shift:CancelZonalShift",
        "arc-zonal-shift:StartZonalShift"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:ap-south-2:*:loadbalancer/app/warden-dev-*/*",
        "arn:aws:elasticloadbalancing:ap-south-2:*:loadbalancer/net/warden-dev-*/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "StageThrottlesOfThisEnvironmentsApis",
      "Effect": "Allow",
      "Action": "apigateway:PATCH",
      "Resource": "arn:aws:apigateway:ap-south-2::/restapis/*/stages/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "dev"
        },
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    },
    {
      "Sid": "EventSourceMappingsOfThisEnvironmentsFunctions",
      "Effect": "Allow",
      "Action": "lambda:UpdateEventSourceMapping",
      "Resource": "arn:aws:lambda:ap-south-2:*:event-source-mapping:*",
      "Condition": {
        "ArnLike": {
          "lambda:FunctionArn": "arn:aws:lambda:ap-south-2:*:function:warden-dev-*"
        },
        "StringLike": {
          "aws:SourceIdentity": "inc-*"
        }
      }
    }
  ]
}
