# Python, caches and build output
# No slash: a .venv that is a symlink is a file to git, and `.venv/` let one be committed (PR 90, CI's uv venv failed).
.venv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
dist/
build/
*.egg-info/
htmlcov/
.coverage
.coverage.*
coverage.xml
mutants/
.mutmut-cache
.mutation-restore.json
*.log

# Local-only working material: per-machine notes, reports and assistant settings. Never published;
# warden/tests/test_local_only_paths.py fails if any of these is ever tracked.
/research_notes/
/reports/
/.claude/
/.review/
/notes/
/scratch/
NEXT-SESSION-PROMPT.txt
*HANDOFF*.md
*FIXLIST*

# Editor and OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Secrets and per-machine configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
**/*.local.json
**/*.local.yaml

# Terraform. State holds every `sensitive` value (the database password included) in plain text, and
# tfvars hold local values. A saved plan is a binary holding every resource attribute and the account
# id, so it is never committed either.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan*
*.tfplan*
plan.out
crash.log
crash.*.log
.terraform.lock.hcl.bak
# The undo lab's function archives, built at plan time.
infra/terraform/undo-lab/.build/

# Benchmark run output. Only the held-out sets (fault-lab/docs/bench/heldout-*) and the recorded runs the tests
# replay (warden/tests/fixtures/bench) are published; raw runs stay outside the repository.
fault-lab/docs/bench/**/runner*.log
fault-lab/docs/bench/**/runs/

# A published AWS proof bundle keeps its transcript. fault-lab/scripts/aws_proof.sh writes every run outside the
# repository, redacts it, and copies it in only after warden/scripts/check_publishable.py passes on it.
!fault-lab/docs/aws-proof-*/run.log
